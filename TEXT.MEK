                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
| get_user_feedback_for_dashboard       | CREATE OR REPLACE FUNCTION public.get_user_feedback_for_dashboard(p_limit integer DEFAULT 5000, p_offset integer DEFAULT 0)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE<br>    v_rows jsonb;<br>BEGIN<br>    SELECT COALESCE(jsonb_agg(to_jsonb(f)), '[]'::jsonb) INTO v_rows<br>    FROM (<br>        SELECT *<br>        FROM public.user_feedback<br>        ORDER BY created_at DESC<br>        LIMIT p_limit<br>        OFFSET p_offset<br>    ) f;<br><br>    RETURN v_rows;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
| get_user_profile_secure               | CREATE OR REPLACE FUNCTION public.get_user_profile_secure(p_username text, p_business_id uuid)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE<br>    v_user public.users;<br>    v_sales_count int;<br>    v_history_count int;<br>BEGIN<br>    -- 1. Set context for this exact transaction<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br>    <br>    -- 2. Get the user (only sales or manager roles)<br>    SELECT * INTO v_user <br>    FROM public.users <br>    WHERE username = p_username AND role IN ('sales', 'manager');<br>    <br>    IF v_user.id IS NULL THEN<br>        RETURN NULL;<br>    END IF;<br>    <br>    -- 3. Get their stats securely<br>    SELECT COUNT(*) INTO v_sales_count <br>    FROM public.sales <br>    WHERE username = p_username AND business_id = p_business_id;<br>    <br>    SELECT COUNT(*) INTO v_history_count <br>    FROM public.stock_history <br>    WHERE username = p_username AND business_id = p_business_id;<br>    <br>    -- 4. Return everything as a single JSON object<br>    RETURN jsonb_build_object(<br>        'user', row_to_json(v_user),<br>        'sales_count', v_sales_count,<br>        'history_count', v_history_count<br>    );<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               