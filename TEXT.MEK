                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
| insert_customer_receipt_secure        | CREATE OR REPLACE FUNCTION public.insert_customer_receipt_secure(p_record jsonb, p_user_id uuid, p_business_id uuid)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE v_result jsonb;<br>BEGIN<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br>    PERFORM set_config('app.current_user_id', p_user_id::text, false);<br>    <br>    INSERT INTO public.customer_receipts (<br>        receipt_id, date, customer_name, cashier, customer_phone, items,<br>        amount_paid, balance_due, advance_payment_amount, advance_payment_date,<br>        payment_type_display, source, user_id, business_id, created_at<br>    ) VALUES (<br>        p_record->>'receipt_id', COALESCE((p_record->>'date')::date, CURRENT_DATE),<br>        p_record->>'customer_name', p_record->>'cashier', p_record->>'customer_phone',<br>        COALESCE((p_record->>'items')::jsonb, '[]'::jsonb),<br>        COALESCE((p_record->>'amount_paid')::numeric, 0), COALESCE((p_record->>'balance_due')::numeric, 0),<br>        COALESCE((p_record->>'advance_payment_amount')::numeric, 0), (p_record->>'advance_payment_date')::date,<br>        COALESCE(p_record->>'payment_type_display', 'Cash'), COALESCE(p_record->>'source', 'custom'),<br>        p_user_id, p_business_id, NOW()<br>    ) RETURNING row_to_json(public.customer_receipts.*) INTO v_result;<br>    RETURN v_result;<br>END; $function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     