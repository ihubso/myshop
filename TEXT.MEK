                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
| insert_notification_secure            | CREATE OR REPLACE FUNCTION public.insert_notification_secure(p_record jsonb, p_user_id uuid, p_business_id uuid)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE v_result jsonb;<br>BEGIN<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br>    PERFORM set_config('app.current_user_id', p_user_id::text, false);<br>    <br>    INSERT INTO public.notifications (<br>        type, event, username, promoter_name, message, recipient_username,<br>        is_read, user_id, business_id, created_at<br>    ) VALUES (<br>        p_record->>'type', p_record->>'event', p_record->>'username',<br>        p_record->>'promoter_name', p_record->>'message',<br>        COALESCE(p_record->>'recipient_username', 'all'),<br>        COALESCE((p_record->>'is_read')::boolean, false),<br>        p_user_id, p_business_id, NOW()<br>    ) RETURNING row_to_json(public.notifications.*) INTO v_result;<br>    RETURN v_result;<br>END; $function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  