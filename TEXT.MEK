                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
| get_user_by_id_secure                 | CREATE OR REPLACE FUNCTION public.get_user_by_id_secure(p_id uuid)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE v_result jsonb;<br>BEGIN<br>    SELECT row_to_json(u) INTO v_result FROM public.users u WHERE u.id = p_id LIMIT 1;<br>    RETURN v_result;<br>END; $function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
| get_user_by_singlebyourytid_secure    | CREATE OR REPLACE FUNCTION public.get_user_by_singlebyourytid_secure(p_user_id uuid)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE<br>    result JSONB;<br>    v_user RECORD;<br>BEGIN<br>    -- Get user with all their data<br>    SELECT <br>        u.id,<br>        u.username,<br>        u.email,<br>        u.full_name,<br>        u.role,<br>        u.business_id,<br>        u.created_at,<br>        u.updated_at,<br>        u.photo_url,<br>        u.phone,<br>        b.name as business_name,<br>        b.language as business_language,<br>        b.currency as business_currency<br>    INTO v_user<br>    FROM users u<br>    LEFT JOIN business_info b ON u.business_id = b.id<br>    WHERE u.id = p_user_id;<br><br>    -- Check if user exists<br>    IF v_user IS NULL THEN<br>        RETURN jsonb_build_object(<br>            'success', false,<br>            'error', 'User not found'<br>        );<br>    END IF;<br><br>    -- Return user data as JSON<br>    result = jsonb_build_object(<br>        'success', true,<br>        'user', jsonb_build_object(<br>            'id', v_user.id,<br>            'username', v_user.username,<br>            'email', v_user.email,<br>            'full_name', v_user.full_name,<br>            'role', v_user.role,<br>            'business_id', v_user.business_id,<br>            'created_at', v_user.created_at,<br>            'updated_at', v_user.updated_at,<br>            'photo_url', v_user.photo_url,<br>            'phone', v_user.phone,<br>            'business_name', v_user.business_name,<br>            'business_language', v_user.business_language,<br>            'business_currency', v_user.business_currency<br>        )<br>    );<br><br>    -- Update last_login regardless (remove the is_active check)<br>    UPDATE users <br>    SET last_login = NOW() <br>    WHERE id = p_user_id;<br><br>    RETURN result;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
| get_user_by_username_secure           | CREATE OR REPLACE FUNCTION public.get_user_by_username_secure(p_username text)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE v_result jsonb;<br>BEGIN<br>    SELECT row_to_json(u) INTO v_result FROM public.users u WHERE u.username = p_username LIMIT 1;<br>    RETURN v_result;<br>END; $function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  