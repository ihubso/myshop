                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
| insert_reminder_secure                | CREATE OR REPLACE FUNCTION public.insert_reminder_secure(p_record jsonb, p_user_id uuid, p_business_id uuid)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE v_result jsonb;<br>BEGIN<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br>    PERFORM set_config('app.current_user_id', p_user_id::text, false);<br>    <br>    INSERT INTO public.reminders (title, message, type, date, time, status, is_active, username, created_by, user_id, business_id, created_at)<br>    VALUES (<br>        p_record->>'title', p_record->>'message', COALESCE(p_record->>'type', 'once'),<br>        (p_record->>'date')::date, COALESCE(p_record->>'time', '09:00'), COALESCE(p_record->>'status', 'active'),<br>        COALESCE((p_record->>'is_active')::boolean, true), COALESCE(p_record->>'username', 'Unknown'),<br>        COALESCE(p_record->>'created_by', 'Unknown'), p_user_id, p_business_id, NOW()<br>    ) RETURNING row_to_json(public.reminders.*) INTO v_result;<br>    RETURN v_result;<br>END; $function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                