                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
| set_current_context                   | CREATE OR REPLACE FUNCTION public.set_current_context(p_user_id uuid, p_business_id uuid)<br> RETURNS void<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>BEGIN<br>    PERFORM set_config('app.current_user_id', p_user_id::text, false);<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
| set_current_user                      | CREATE OR REPLACE FUNCTION public.set_current_user(user_id uuid)<br> RETURNS void<br> LANGUAGE plpgsql<br> SET search_path TO 'public'<br>AS $function$<br>BEGIN<br>    PERFORM set_config('app.current_user_id', user_id::text, FALSE);<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
| set_user_id_on_insert                 | CREATE OR REPLACE FUNCTION public.set_user_id_on_insert()<br> RETURNS trigger<br> LANGUAGE plpgsql<br> SET search_path TO 'public'<br>AS $function$<br>BEGIN<br>    -- If user_id is NULL, set it from current setting<br>    IF NEW.user_id IS NULL THEN<br>        NEW.user_id = current_setting('app.current_user_id', TRUE)::UUID;<br>    END IF;<br>    RETURN NEW;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
| update_business_info_secure           | CREATE OR REPLACE FUNCTION public.update_business_info_secure(p_id uuid, p_record jsonb, p_business_id uuid)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE<br>    v_result jsonb;<br>BEGIN<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br><br>    UPDATE public.business_info<br>    SET<br>        name                    = COALESCE(p_record->>'name', name),<br>        address                 = COALESCE(p_record->>'address', address),<br>        phone                   = COALESCE(p_record->>'phone', phone),<br>        phone_number_two        = COALESCE(p_record->>'phone_number_two', phone_number_two),<br>        email                   = COALESCE(p_record->>'email', email),<br>        website                 = COALESCE(p_record->>'website', website),<br>        social_media_handles    = COALESCE(p_record->>'social_media_handles', social_media_handles),<br>        details                 = COALESCE(p_record->>'details', details),<br>        logo_url                = COALESCE(p_record->>'logo_url', logo_url),<br>        currency                = COALESCE(p_record->>'currency', currency),<br>        language                = COALESCE(p_record->>'language', language),<br>        font_style              = COALESCE(p_record->>'font_style', font_style),<br>        warranty_duration       = COALESCE(NULLIF(p_record->>'warranty_duration','')::int, warranty_duration),<br>        warranty_unit           = COALESCE(p_record->>'warranty_unit', warranty_unit),<br>        warranty_text           = COALESCE(p_record->>'warranty_text', warranty_text),<br>        festive_badge_enabled   = COALESCE((p_record->>'festive_badge_enabled')::boolean, festive_badge_enabled),<br>        current_badge_index     = COALESCE(NULLIF(p_record->>'current_badge_index','')::int, current_badge_index),<br>        use_custom_badge        = COALESCE((p_record->>'use_custom_badge')::boolean, use_custom_badge),<br>        custom_badge_text       = COALESCE(p_record->>'custom_badge_text', custom_badge_text),<br>        setup_completed         = COALESCE((p_record->>'setup_completed')::boolean, setup_completed),<br>        description             = COALESCE(p_record->>'description', description),<br>        email_alerts_enabled    = COALESCE((p_record->>'email_alerts_enabled')::boolean, email_alerts_enabled),<br>        dashboard_preferences   = COALESCE(p_record->'dashboard_preferences', dashboard_preferences),<br>        supermarket_settings    = COALESCE(p_record->'supermarket_settings', supermarket_settings),  -- ⬅️ NEW<br>        updated_at              = NOW()<br>    WHERE id = p_id<br>    RETURNING row_to_json(business_info.*) INTO v_result;<br><br>    IF v_result IS NULL THEN<br>        RAISE EXCEPTION 'Business % not found', p_id;<br>    END IF;<br><br>    RETURN v_result;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
| update_credit_sale_secure             | CREATE OR REPLACE FUNCTION public.update_credit_sale_secure(p_id uuid, p_record jsonb, p_business_id uuid)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE<br>    v_result jsonb;<br>    v_payments JSONB;<br>    v_status TEXT;<br>    v_credit_balance NUMERIC;<br>    v_date_paid DATE;<br>    v_paid_amount NUMERIC;<br>BEGIN<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br>    <br>    -- Extract values<br>    v_status := COALESCE(p_record->>'status', 'pending');<br>    v_credit_balance := COALESCE((p_record->>'credit_balance')::NUMERIC, 0);<br>    v_paid_amount := COALESCE((p_record->>'paid_amount')::NUMERIC, 0);<br>    <br>    IF p_record->>'date_paid' IS NOT NULL AND p_record->>'date_paid' != '' THEN<br>        v_date_paid := (p_record->>'date_paid')::DATE;<br>    ELSE<br>        v_date_paid := NULL;<br>    END IF;<br>    <br>    v_payments := p_record->'payments';<br>    <br>    -- Update<br>    UPDATE public.credit_sales<br>    SET <br>        status = v_status,<br>        credit_balance = v_credit_balance,<br>        date_paid = v_date_paid,<br>        paid_amount = v_paid_amount,<br>        payments = CASE <br>            WHEN v_payments IS NOT NULL AND jsonb_array_length(v_payments) > 0 <br>            THEN v_payments <br>            ELSE COALESCE(payments, '[]'::JSONB) <br>        END,<br>        updated_at = NOW()<br>    WHERE id = p_id<br>    AND business_id = p_business_id<br>    RETURNING row_to_json(public.credit_sales.*) INTO v_result;<br>    <br>    RETURN v_result;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
| update_customer_receipt_secure        | CREATE OR REPLACE FUNCTION public.update_customer_receipt_secure(p_receipt_id text, p_record jsonb, p_business_id uuid)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE<br>    v_receipt public.customer_receipts;<br>    v_result jsonb;<br>BEGIN<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br>    <br>    SELECT * INTO v_receipt FROM public.customer_receipts WHERE receipt_id = p_receipt_id;<br>    <br>    IF v_receipt.id IS NULL THEN<br>        RAISE EXCEPTION 'Receipt not found';<br>    END IF;<br>    <br>    -- Safely populate with new values (handles all type casting automatically!)<br>    v_receipt := jsonb_populate_record(v_receipt, p_record);<br>    v_receipt.updated_at = NOW();<br>    <br>    UPDATE public.customer_receipts<br>    SET <br>        date = v_receipt.date,<br>        customer_name = v_receipt.customer_name,<br>        cashier = v_receipt.cashier,<br>        customer_phone = v_receipt.customer_phone,<br>        items = v_receipt.items,<br>        amount_paid = v_receipt.amount_paid,<br>        balance_due = v_receipt.balance_due,<br>        advance_payment_amount = v_receipt.advance_payment_amount,<br>        advance_payment_date = v_receipt.advance_payment_date,<br>        payment_type_display = v_receipt.payment_type_display,<br>        source = v_receipt.source,<br>        updated_at = v_receipt.updated_at<br>    WHERE receipt_id = p_receipt_id<br>    RETURNING row_to_json(public.customer_receipts.*) INTO v_result;<br>    <br>    RETURN v_result;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |