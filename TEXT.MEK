                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
| get_user_secure                       | CREATE OR REPLACE FUNCTION public.get_user_secure(p_user_id uuid, p_business_id uuid)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE<br>    v_result jsonb;<br>BEGIN<br>    -- Set context for this exact transaction<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br>    <br>    -- Fetch the user and return as JSON<br>    SELECT row_to_json(u.*) INTO v_result <br>    FROM public.users u <br>    WHERE u.id = p_user_id;<br>    <br>    RETURN v_result;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
| get_user_setups_for_dashboard         | CREATE OR REPLACE FUNCTION public.get_user_setups_for_dashboard(p_limit integer DEFAULT 5000, p_offset integer DEFAULT 0)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE<br>    v_rows jsonb;<br>BEGIN<br>    SELECT COALESCE(jsonb_agg(to_jsonb(s)), '[]'::jsonb) INTO v_rows<br>    FROM (<br>        SELECT *<br>        FROM public.user_setups<br>        ORDER BY created_at DESC<br>        LIMIT p_limit<br>        OFFSET p_offset<br>    ) s;<br><br>    RETURN v_rows;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
| get_user_updates_for_dashboard        | CREATE OR REPLACE FUNCTION public.get_user_updates_for_dashboard(p_limit integer DEFAULT 5000, p_offset integer DEFAULT 0)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE<br>    v_rows jsonb;<br>BEGIN<br>    SELECT COALESCE(jsonb_agg(to_jsonb(u)), '[]'::jsonb) INTO v_rows<br>    FROM (<br>        SELECT *<br>        FROM public.userupdate<br>        ORDER BY created_at DESC<br>        LIMIT p_limit<br>        OFFSET p_offset<br>    ) u;<br><br>    RETURN v_rows;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  