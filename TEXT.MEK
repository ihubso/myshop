                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
| delete_user_secure                    | CREATE OR REPLACE FUNCTION public.delete_user_secure(p_username text, p_business_id uuid)<br> RETURNS void<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>BEGIN<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br>    DELETE FROM public.users WHERE username = p_username;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
| emit_business_event                   | CREATE OR REPLACE FUNCTION public.emit_business_event()<br> RETURNS trigger<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE<br>  v_business_id UUID;<br>  v_event_type  TEXT;<br>  v_payload     JSONB;<br>BEGIN<br>  -- Which row changed?<br>  IF TG_TABLE_NAME = 'sales' THEN<br>    v_business_id := NEW.business_id;<br>    IF TG_OP = 'INSERT' THEN<br>      v_event_type := 'new_sale';<br>      v_payload := jsonb_build_object(<br>        'id',            NEW.id,<br>        'product_name',  NEW.product_name,<br>        'username',      NEW.username,<br>        'price',         NEW.price,<br>        'quantity',      NEW.quantity,<br>        'receipt_id',    NEW.receipt_id<br>      );<br>    END IF;<br><br>  ELSIF TG_TABLE_NAME = 'tasks' THEN<br>    v_business_id := NEW.business_id;<br>    IF TG_OP = 'INSERT' THEN<br>      v_event_type := 'new_task';<br>      v_payload := jsonb_build_object(<br>        'id',         NEW.id,<br>        'title',      NEW.title,<br>        'assigned_to', NEW.assigned_to,<br>        'created_by', NEW.created_by<br>      );<br>    END IF;<br><br>  ELSIF TG_TABLE_NAME = 'stock' THEN<br>    v_business_id := NEW.business_id;<br>    IF TG_OP = 'UPDATE' AND (OLD.quantity IS DISTINCT FROM NEW.quantity) THEN<br>      -- Only emit if we crossed the low-stock threshold<br>      IF NEW.quantity < 3 AND (OLD.quantity IS NULL OR OLD.quantity >= 3) THEN<br>        v_event_type := 'low_stock';<br>        v_payload := jsonb_build_object(<br>          'id',       NEW.id,<br>          'name',     NEW.name,<br>          'quantity', NEW.quantity<br>        );<br>      END IF;<br>    END IF;<br><br>  ELSIF TG_TABLE_NAME = 'credit_sales' THEN<br>    v_business_id := NEW.business_id;<br>    IF TG_OP = 'INSERT' THEN<br>      v_event_type := 'new_credit_sale';<br>      v_payload := jsonb_build_object(<br>        'id',             NEW.id,<br>        'customer_name',  NEW.customer_name,<br>        'total_amount',   NEW.total_amount,<br>        'due_date',       NEW.due_date<br>      );<br>    END IF;<br><br>  ELSIF TG_TABLE_NAME = 'customer_receipts' THEN<br>    v_business_id := NEW.business_id;<br>    IF TG_OP = 'INSERT' THEN<br>      v_event_type := 'new_receipt';<br>      v_payload := jsonb_build_object(<br>        'id',          NEW.id,<br>        'receipt_id',  NEW.receipt_id,<br>        'customer_name', NEW.customer_name<br>      );<br>    END IF;<br>  END IF;<br><br>  -- If nothing matched, do nothing<br>  IF v_business_id IS NULL OR v_event_type IS NULL THEN<br>    RETURN NEW;<br>  END IF;<br><br>  -- Insert the event<br>  INSERT INTO public.business_events (business_id, event_type, payload)<br>  VALUES (v_business_id, v_event_type, v_payload);<br><br>  RETURN NEW;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
| emit_dashboard_prefs_change           | CREATE OR REPLACE FUNCTION public.emit_dashboard_prefs_change()<br> RETURNS trigger<br> LANGUAGE plpgsql<br> SET search_path TO ''<br>AS $function$<br>BEGIN<br>    IF (OLD.dashboard_preferences IS DISTINCT FROM NEW.dashboard_preferences) THEN<br>        INSERT INTO public.business_events (business_id, event_type, payload)<br>        VALUES (<br>            NEW.id,<br>            'dashboard_preferences_changed',<br>            jsonb_build_object(<br>                'widgetVisibility', NEW.dashboard_preferences->'widgetVisibility',<br>                'compactNumbers',   NEW.dashboard_preferences->'compactNumbers'<br>            )<br>        );<br>    END IF;<br>    RETURN NEW;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
| emit_supermarket_settings_change      | CREATE OR REPLACE FUNCTION public.emit_supermarket_settings_change()<br> RETURNS trigger<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>BEGIN<br>    IF (OLD.supermarket_settings IS DISTINCT FROM NEW.supermarket_settings) THEN<br>        INSERT INTO public.business_events (business_id, event_type, payload)<br>        VALUES (<br>            NEW.id,<br>            'supermarket_settings_changed',<br>            jsonb_build_object(<br>                'settings', NEW.supermarket_settings,<br>                'changedAt', NOW()<br>            )<br>        );<br>    END IF;<br>    RETURN NEW;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
| emit_user_role_change                 | CREATE OR REPLACE FUNCTION public.emit_user_role_change()<br> RETURNS trigger<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE<br>    v_event_type TEXT;<br>BEGIN<br>    -- Only fire on actual role changes<br>    IF OLD.role IS DISTINCT FROM NEW.role THEN<br>        IF NEW.role = 'manager' AND OLD.role = 'sales' THEN<br>            v_event_type := 'user_promoted';<br>        ELSIF NEW.role = 'sales' AND OLD.role = 'manager' THEN<br>            v_event_type := 'user_demoted';<br>        ELSE<br>            v_event_type := 'user_role_changed';<br>        END IF;<br><br>        INSERT INTO public.business_events (business_id, event_type, payload)<br>        VALUES (<br>            NEW.business_id,<br>            v_event_type,<br>            jsonb_build_object(<br>                'userId',         NEW.id,<br>                'username',       NEW.username,<br>                'fullName',       NEW.full_name,<br>                'email',          NEW.email,<br>                'photoUrl',       NEW.photo_url,<br>                'oldRole',        OLD.role,<br>                'newRole',        NEW.role,<br>                'promotedAt',     NEW.promoted_at,<br>                'promotedBy',     NEW.promoted_by,<br>                'demotedAt',      NEW.demoted_at,<br>                'promotionLabel', NEW.promotion_date_label,<br>                'changedAt',      NOW()<br>            )<br>        );<br>    END IF;<br>    RETURN NEW;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
| fix_business_rls                      | CREATE OR REPLACE FUNCTION public.fix_business_rls(tbl_name text)<br> RETURNS void<br> LANGUAGE plpgsql<br> SET search_path TO 'public'<br>AS $function$<br>BEGIN<br>    -- Drop old policies<br>    EXECUTE format('DROP POLICY IF EXISTS %I_select ON public.%I', tbl_name, tbl_name);<br>    EXECUTE format('DROP POLICY IF EXISTS %I_insert ON public.%I', tbl_name, tbl_name);<br>    EXECUTE format('DROP POLICY IF EXISTS %I_update ON public.%I', tbl_name, tbl_name);<br>    EXECUTE format('DROP POLICY IF EXISTS %I_delete_blocked ON public.%I', tbl_name, tbl_name);<br><br>    -- Create new policies with app.current_business_id<br>    EXECUTE format('CREATE POLICY %I_select ON public.%I FOR SELECT USING (business_id::text = current_setting(''app.current_business_id'', true))', tbl_name, tbl_name);<br>    EXECUTE format('CREATE POLICY %I_insert ON public.%I FOR INSERT WITH CHECK (business_id::text = current_setting(''app.current_business_id'', true))', tbl_name, tbl_name);<br>    EXECUTE format('CREATE POLICY %I_update ON public.%I FOR UPDATE USING (business_id::text = current_setting(''app.current_business_id'', true)) WITH CHECK (business_id::text = current_setting(''app.current_business_id'', true))', tbl_name, tbl_name);<br>    EXECUTE format('CREATE POLICY %I_delete_blocked ON public.%I FOR DELETE USING (false)', tbl_name, tbl_name);<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
| get_active_device_fingerprints_secure | CREATE OR REPLACE FUNCTION public.get_active_device_fingerprints_secure(p_business_id uuid, p_seven_days_ago timestamp with time zone)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE<br>    v_result jsonb;<br>BEGIN<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br>    <br>    -- Returns a simple JSON array of strings, e.g., ["fp1", "fp2"]<br>    SELECT jsonb_agg(device_fingerprint) INTO v_result<br>    FROM public.active_devices<br>    WHERE business_id = p_business_id<br>      AND last_active >= p_seven_days_ago;<br>      <br>    RETURN COALESCE(v_result, '[]'::jsonb);<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
| get_active_devices_secure             | CREATE OR REPLACE FUNCTION public.get_active_devices_secure(p_business_id uuid)<br> RETURNS TABLE(id uuid, device_fingerprint text, device_name text, last_active timestamp with time zone)<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>BEGIN<br>    -- Set context for RLS (if you have RLS on active_devices)<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br>    <br>    -- Return full device records ordered by most recently active<br>    RETURN QUERY<br>    SELECT <br>        ad.id,<br>        ad.device_fingerprint,<br>        ad.device_name,<br>        ad.last_active<br>    FROM public.active_devices ad<br>    WHERE ad.business_id = p_business_id<br>    ORDER BY ad.last_active DESC;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
| get_admin_profile_secure              | CREATE OR REPLACE FUNCTION public.get_admin_profile_secure(p_username text, p_business_id uuid)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE<br>    v_user public.users;<br>BEGIN<br>    -- 1. Set context for this exact transaction<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br>    <br>    -- 2. Get the user (only administrator role, case-insensitive username match)<br>    SELECT * INTO v_user <br>    FROM public.users <br>    WHERE LOWER(username) = LOWER(p_username) AND role = 'administrator';<br>    <br>    IF v_user.id IS NULL THEN<br>        RETURN NULL;<br>    END IF;<br>    <br>    -- 3. Return as JSON<br>    RETURN row_to_json(v_user);<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
| get_all_customers_secure              | CREATE OR REPLACE FUNCTION public.get_all_customers_secure(p_business_id uuid)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE<br>    v_customers jsonb;<br>BEGIN<br>    -- 1. Set context for this exact transaction<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br>    <br>    -- 2. Aggregate, deduplicate, and fill in missing phone numbers<br>    SELECT jsonb_agg(row_to_json(subq)) INTO v_customers<br>    FROM (<br>        SELECT name, MAX(phone) AS phone<br>        FROM (<br>            SELECT customer_name AS name, customer_phone AS phone FROM public.sales WHERE business_id = p_business_id<br>            UNION ALL<br>            SELECT customer_name AS name, customer_phone AS phone FROM public.credit_sales WHERE business_id = p_business_id<br>            UNION ALL<br>            SELECT name, phone FROM public.customers WHERE business_id = p_business_id<br>        ) AS combined<br>        WHERE name IS NOT NULL <br>          AND TRIM(name) != '' <br>          AND TRIM(name) != 'Tapez le nom du client'<br>        GROUP BY name<br>        ORDER BY name ASC<br>    ) AS subq;<br>    <br>    -- 3. Return empty array if no customers found<br>    RETURN COALESCE(v_customers, '[]'::jsonb);<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
| get_app_events_for_dashboard          | CREATE OR REPLACE FUNCTION public.get_app_events_for_dashboard(p_start_date timestamp with time zone DEFAULT NULL::timestamp with time zone, p_end_date timestamp with time zone DEFAULT NULL::timestamp with time zone, p_limit integer DEFAULT 10000, p_offset integer DEFAULT 0)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE<br>    v_rows  jsonb;<br>    v_total integer;<br>BEGIN<br>    SELECT count(*) INTO v_total<br>    FROM public.app_events<br>    WHERE (p_start_date IS NULL OR created_at >= p_start_date)<br>      AND (p_end_date   IS NULL OR created_at <= p_end_date);<br><br>    SELECT COALESCE(jsonb_agg(to_jsonb(e)), '[]'::jsonb) INTO v_rows<br>    FROM (<br>        SELECT *<br>        FROM public.app_events<br>        WHERE (p_start_date IS NULL OR created_at >= p_start_date)<br>          AND (p_end_date   IS NULL OR created_at <= p_end_date)<br>        ORDER BY created_at DESC<br>        LIMIT p_limit<br>        OFFSET p_offset<br>    ) e;<br><br>    RETURN jsonb_build_object(<br>        'total', v_total,<br>        'rows',  v_rows<br>    );<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
| get_available_usernames_secure        | CREATE OR REPLACE FUNCTION public.get_available_usernames_secure(p_usernames text[])<br> RETURNS SETOF text<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>BEGIN<br>    -- Return usernames from the input array that DO NOT exist in the users table<br>    RETURN QUERY <br>    SELECT username FROM unnest(p_usernames) AS username<br>    EXCEPT<br>    SELECT username FROM public.users;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
| get_business_info_by_id_secure        | CREATE OR REPLACE FUNCTION public.get_business_info_by_id_secure(p_id uuid)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE v_result jsonb;<br>BEGIN<br>    PERFORM set_config('app.current_business_id', p_id::text, false);<br>    SELECT row_to_json(b) INTO v_result FROM public.business_info b WHERE b.id = p_id LIMIT 1;<br>    RETURN v_result;<br>END; $function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
| get_business_info_secure              | CREATE OR REPLACE FUNCTION public.get_business_info_secure(p_business_id uuid)<br> RETURNS SETOF business_info<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>BEGIN<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br>    RETURN QUERY SELECT * FROM public.business_info WHERE id = p_business_id;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       