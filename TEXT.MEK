| function_name                         | function_definition                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
| ------------------------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ |
| activate_license_secure               | CREATE OR REPLACE FUNCTION public.activate_license_secure(p_user_id uuid, p_business_id uuid, p_business_name text, p_business_email text, p_business_phone text, p_owner_name text, p_currency text, p_language text, p_plan text, p_interval text, p_amount numeric, p_reference text, p_payment_method text)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE<br>    v_new_business_id uuid;<br>    v_business record;<br>    v_expiry timestamptz;<br>    v_result jsonb;<br>BEGIN<br>    -- Calculate expiry based on interval<br>    IF p_interval = 'yearly' THEN<br>        v_expiry := NOW() + INTERVAL '1 year';<br>    ELSE<br>        v_expiry := NOW() + INTERVAL '1 month';<br>    END IF;<br><br>    -- Check if business already exists<br>    SELECT * INTO v_business FROM public.business_info WHERE id = p_business_id;<br><br>    IF v_business.id IS NULL THEN<br>        -- Create new business<br>        INSERT INTO public.business_info (<br>            name, email, phone, owner_name, currency, language, <br>            license_status, license_plan, license_expires_at, license_activated_at<br>        ) VALUES (<br>            p_business_name, p_business_email, p_business_phone, p_owner_name, p_currency, p_language,<br>            'active', p_plan, v_expiry, NOW()<br>        ) RETURNING id INTO v_new_business_id;<br>        <br>        -- Link user to the new business<br>        UPDATE public.users SET business_id = v_new_business_id WHERE id = p_user_id;<br>    ELSE<br>        -- Update existing business license<br>        UPDATE public.business_info SET<br>            license_status = 'active',<br>            license_plan = p_plan,<br>            license_expires_at = v_expiry,<br>            license_activated_at = NOW()<br>        WHERE id = p_business_id;<br>        v_new_business_id := p_business_id;<br>    END IF;<br><br>    -- Record the transaction securely<br>    INSERT INTO public.transactions (<br>        user_id, business_id, reference, plan, amount, interval, status, payment_method, is_subscription, created_at<br>    ) VALUES (<br>        p_user_id, v_new_business_id, p_reference, p_plan, p_amount, p_interval, 'completed', p_payment_method, (p_payment_method = 'paystack_subscription'), NOW()<br>    );<br><br>    -- Return the fully activated business info<br>    SELECT row_to_json(b) INTO v_result FROM public.business_info b WHERE b.id = v_new_business_id;<br>    RETURN v_result;<br>END; $function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
| assert_session                        | CREATE OR REPLACE FUNCTION public.assert_session(p_token text, p_business_id uuid)<br> RETURNS uuid<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE<br>    v_user_id uuid;<br>BEGIN<br>    IF p_token IS NULL OR btrim(p_token) = '' THEN<br>        RAISE EXCEPTION 'Missing session token' USING ERRCODE = '42501';<br>    END IF;<br>    IF p_business_id IS NULL THEN<br>        RAISE EXCEPTION 'Missing business id' USING ERRCODE = '42501';<br>    END IF;<br><br>    SELECT s.user_id INTO v_user_id<br>    FROM public.sessions s<br>    WHERE s.token       = p_token<br>      AND s.business_id = p_business_id<br>      AND s.expires_at  > now();<br><br>    IF v_user_id IS NULL THEN<br>        RAISE EXCEPTION 'Invalid or expired session' USING ERRCODE = '42501';<br>    END IF;<br><br>    -- Refresh last_seen_at (cheap: one row update)<br>    UPDATE public.sessions<br>       SET last_seen_at = now()<br>     WHERE token = p_token;<br><br>    RETURN v_user_id;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
| assert_session_user                   | CREATE OR REPLACE FUNCTION public.assert_session_user(p_token text, p_user_id uuid)<br> RETURNS void<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>BEGIN<br>    IF p_token IS NULL OR btrim(p_token) = '' THEN<br>        RAISE EXCEPTION 'Missing session token' USING ERRCODE = '42501';<br>    END IF;<br><br>    IF NOT EXISTS (<br>        SELECT 1 FROM public.sessions<br>         WHERE token      = p_token<br>           AND user_id    = p_user_id<br>           AND expires_at > now()<br>    ) THEN<br>        RAISE EXCEPTION 'Invalid or expired session' USING ERRCODE = '42501';<br>    END IF;<br><br>    UPDATE public.sessions SET last_seen_at = now() WHERE token = p_token;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
| check_and_record_device_visit         | CREATE OR REPLACE FUNCTION public.check_and_record_device_visit(p_user_id uuid, p_business_id uuid, p_device_type text)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE<br>  v_row public.user_device_visits;<br>BEGIN<br>  IF p_user_id IS NULL OR p_business_id IS NULL THEN<br>    RAISE EXCEPTION 'user_id and business_id required' USING ERRCODE = 'check_violation';<br>  END IF;<br><br>  IF p_device_type NOT IN ('mobile','tablet','desktop') THEN<br>    RAISE EXCEPTION 'invalid device_type' USING ERRCODE = 'check_violation';<br>  END IF;<br><br>  -- Confirm the user actually belongs to this business (belt & braces)<br>  IF NOT EXISTS (<br>    SELECT 1 FROM public.users<br>    WHERE id = p_user_id AND business_id = p_business_id<br>  ) THEN<br>    RAISE EXCEPTION 'user does not belong to business' USING ERRCODE = 'check_violation';<br>  END IF;<br><br>  -- Try to find an existing record<br>  SELECT * INTO v_row<br>  FROM public.user_device_visits<br>  WHERE user_id = p_user_id AND device_type = p_device_type;<br><br>  IF v_row.id IS NULL THEN<br>    -- First visit on this device type for this user<br>    INSERT INTO public.user_device_visits (user_id, device_type)<br>    VALUES (p_user_id, p_device_type)<br>    RETURNING * INTO v_row;<br><br>    RETURN jsonb_build_object(<br>      'is_first_visit', true,<br>      'device_type',    p_device_type,<br>      'first_seen_at',  v_row.first_seen_at<br>    );<br>  ELSE<br>    -- Already visited — just bump last_seen_at<br>    UPDATE public.user_device_visits<br>    SET last_seen_at = now()<br>    WHERE id = v_row.id;<br><br>    RETURN jsonb_build_object(<br>      'is_first_visit', false,<br>      'device_type',    p_device_type,<br>      'first_seen_at',  v_row.first_seen_at<br>    );<br>  END IF;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
| check_and_record_device_visit_secure  | CREATE OR REPLACE FUNCTION public.check_and_record_device_visit_secure(p_user_id uuid, p_business_id uuid, p_device_type text)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE<br>  v_row public.user_device_visits;<br>BEGIN<br>  IF p_user_id IS NULL OR p_business_id IS NULL THEN<br>    RAISE EXCEPTION 'user_id and business_id required' USING ERRCODE = 'check_violation';<br>  END IF;<br>  IF p_device_type NOT IN ('mobile','tablet','desktop') THEN<br>    RAISE EXCEPTION 'invalid device_type' USING ERRCODE = 'check_violation';<br>  END IF;<br>  IF NOT EXISTS (<br>    SELECT 1 FROM public.users<br>    WHERE id = p_user_id AND business_id = p_business_id<br>  ) THEN<br>    RAISE EXCEPTION 'user does not belong to business' USING ERRCODE = 'check_violation';<br>  END IF;<br><br>  SELECT * INTO v_row FROM public.user_device_visits<br>  WHERE user_id = p_user_id AND device_type = p_device_type;<br><br>  IF v_row.id IS NULL THEN<br>    INSERT INTO public.user_device_visits (user_id, device_type)<br>    VALUES (p_user_id, p_device_type) RETURNING * INTO v_row;<br>    RETURN jsonb_build_object('is_first_visit', true, 'device_type', p_device_type);<br>  ELSE<br>    UPDATE public.user_device_visits SET last_seen_at = now() WHERE id = v_row.id;<br>    RETURN jsonb_build_object('is_first_visit', false, 'device_type', p_device_type);<br>  END IF;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
| check_email_exists_secure             | CREATE OR REPLACE FUNCTION public.check_email_exists_secure(p_email text)<br> RETURNS boolean<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE<br>    v_exists boolean;<br>BEGIN<br>    -- Check if the email exists in the users table<br>    SELECT EXISTS (<br>        SELECT 1 FROM public.users WHERE email = p_email<br>    ) INTO v_exists;<br>    <br>    RETURN v_exists;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
| check_rate_limit                      | CREATE OR REPLACE FUNCTION public.check_rate_limit(p_key text, p_max integer, p_window_seconds integer)<br> RETURNS boolean<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE<br>  v_row public.rate_limits;<br>BEGIN<br>  IF p_max <= 0 OR p_window_seconds <= 0 THEN<br>    RETURN false;   -- defensive: invalid config always denies<br>  END IF;<br><br>  SELECT * INTO v_row FROM public.rate_limits WHERE key = p_key FOR UPDATE;<br><br>  IF NOT FOUND OR v_row.reset_at < now() THEN<br>    INSERT INTO public.rate_limits (key, count, reset_at)<br>    VALUES (p_key, 1, now() + (p_window_seconds \|\| ' seconds')::interval)<br>    ON CONFLICT (key) DO UPDATE<br>      SET count = 1, reset_at = excluded.reset_at;<br>    RETURN true;<br>  END IF;<br><br>  IF v_row.count >= p_max THEN<br>    RETURN false;<br>  END IF;<br><br>  UPDATE public.rate_limits SET count = count + 1 WHERE key = p_key;<br>  RETURN true;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
| check_username_exists_secure          | CREATE OR REPLACE FUNCTION public.check_username_exists_secure(p_username text)<br> RETURNS boolean<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE<br>    v_exists boolean;<br>BEGIN<br>    -- Check if the username exists in the users table<br>    SELECT EXISTS (<br>        SELECT 1 FROM public.users WHERE username = p_username<br>    ) INTO v_exists;<br>    <br>    RETURN v_exists;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
| cleanup_ephemeral_tables              | CREATE OR REPLACE FUNCTION public.cleanup_ephemeral_tables()<br> RETURNS void<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE v_deleted int;<br>BEGIN<br>  -- password_reset_codes<br>  DELETE FROM public.password_reset_codes<br>  WHERE (consumed_at IS NOT NULL AND consumed_at < now() - interval '1 day')<br>     OR (expires_at  IS NOT NULL AND expires_at  < now() - interval '1 day');<br>  GET DIAGNOSTICS v_deleted = ROW_COUNT; RAISE NOTICE 'password_reset_codes: %', v_deleted;<br><br>  -- password_reset_tokens<br>  DELETE FROM public.password_reset_tokens<br>  WHERE (used_at    IS NOT NULL AND used_at    < now() - interval '1 day')<br>     OR (expires_at IS NOT NULL AND expires_at < now() - interval '1 day');<br>  GET DIAGNOSTICS v_deleted = ROW_COUNT; RAISE NOTICE 'password_reset_tokens: %', v_deleted;<br><br>  -- password_reset_attempts<br>  DELETE FROM public.password_reset_attempts<br>  WHERE (locked_until IS NULL OR locked_until < now() - interval '1 day')<br>    AND COALESCE(failed_attempts, 0) = 0;<br>  GET DIAGNOSTICS v_deleted = ROW_COUNT; RAISE NOTICE 'password_reset_attempts: %', v_deleted;<br><br>  -- email_verifications<br>  DELETE FROM public.email_verifications<br>  WHERE (consumed_at IS NOT NULL AND consumed_at < now() - interval '1 day')<br>     OR (expires_at  IS NOT NULL AND expires_at  < now() - interval '1 day');<br>  GET DIAGNOSTICS v_deleted = ROW_COUNT; RAISE NOTICE 'email_verifications: %', v_deleted;<br><br>  -- verified_emails<br>  DELETE FROM public.verified_emails<br>  WHERE (consumed_at IS NOT NULL AND consumed_at < now() - interval '1 day')<br>     OR (expires_at  IS NOT NULL AND expires_at  < now() - interval '1 day');<br>  GET DIAGNOSTICS v_deleted = ROW_COUNT; RAISE NOTICE 'verified_emails: %', v_deleted;<br><br>  -- device_clear_challenges<br>  DELETE FROM public.device_clear_challenges<br>  WHERE (used_at    IS NOT NULL AND used_at    < now() - interval '1 day')<br>     OR (expires_at IS NOT NULL AND expires_at < now() - interval '1 day');<br>  GET DIAGNOSTICS v_deleted = ROW_COUNT; RAISE NOTICE 'device_clear_challenges: %', v_deleted;<br><br>  -- rate_limits  ← NEW<br>  DELETE FROM public.rate_limits WHERE reset_at < now() - interval '1 day';<br>  GET DIAGNOSTICS v_deleted = ROW_COUNT; RAISE NOTICE 'rate_limits: %', v_deleted;<br><br>  -- user_sessions<br>  DELETE FROM public.user_sessions<br>  WHERE (revoked_at IS NOT NULL AND revoked_at < now() - interval '30 days')<br>     OR (expires_at IS NOT NULL AND expires_at < now() - interval '30 days');<br>  GET DIAGNOSTICS v_deleted = ROW_COUNT; RAISE NOTICE 'user_sessions: %', v_deleted;<br><br>  -- business_events<br>  DELETE FROM public.business_events WHERE created_at < now() - interval '90 days';<br>  GET DIAGNOSTICS v_deleted = ROW_COUNT; RAISE NOTICE 'business_events: %', v_deleted;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
| cleanup_old_notifications             | CREATE OR REPLACE FUNCTION public.cleanup_old_notifications()<br> RETURNS void<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>BEGIN<br>    -- Delete notifications older than 21 days (3 weeks) for specific types<br>    DELETE FROM public.notifications<br>    WHERE created_at < NOW() - INTERVAL '21 days'<br>    AND type IN ('daily_combined_report', 'manager_promoted', 'outstanding_balances_reminder');<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
| cleanup_old_sessions                  | CREATE OR REPLACE FUNCTION public.cleanup_old_sessions(p_retention_hours integer DEFAULT 24)<br> RETURNS integer<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public', 'pg_temp'<br>AS $function$<br>DECLARE<br>  v_cutoff  timestamptz := now() - make_interval(hours => p_retention_hours);<br>  v_deleted int;<br>BEGIN<br>  WITH deleted AS (<br>    DELETE FROM public.user_sessions<br>    WHERE (revoked_at IS NOT NULL OR expires_at < now())        -- dead<br>      AND COALESCE(last_seen_at, created_at) < v_cutoff         -- inactive 24h+<br>    RETURNING 1<br>  )<br>  SELECT COUNT(*) INTO v_deleted FROM deleted;<br><br>  RETURN v_deleted;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
| clear_active_devices_secure           | CREATE OR REPLACE FUNCTION public.clear_active_devices_secure(p_business_id uuid)<br> RETURNS void<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>BEGIN<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br>    DELETE FROM public.active_devices WHERE business_id = p_business_id;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
| clear_completed_tasks_secure          | CREATE OR REPLACE FUNCTION public.clear_completed_tasks_secure(p_business_id uuid)<br> RETURNS void<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>BEGIN<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br>    DELETE FROM public.tasks<br>     WHERE status = 'completed'<br>       AND business_id = p_business_id;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
| create_push_subscription_secure       | CREATE OR REPLACE FUNCTION public.create_push_subscription_secure(p_endpoint text, p_p256dh text, p_auth text, p_user_agent text, p_user_id text, p_business_id uuid, p_vapid_key text)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE<br>    v_row public.push_subscriptions;<br>BEGIN<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br><br>    IF p_endpoint IS NULL OR length(trim(p_endpoint)) = 0 THEN<br>        RAISE EXCEPTION 'endpoint is required';<br>    END IF;<br>    IF p_p256dh IS NULL OR length(trim(p_p256dh)) = 0 THEN<br>        RAISE EXCEPTION 'p256dh key is required';<br>    END IF;<br>    IF p_auth IS NULL OR length(trim(p_auth)) = 0 THEN<br>        RAISE EXCEPTION 'auth key is required';<br>    END IF;<br>    IF p_business_id IS NULL THEN<br>        RAISE EXCEPTION 'business_id is required';<br>    END IF;<br><br>    INSERT INTO public.push_subscriptions (<br>        business_id,<br>        user_id,<br>        endpoint,<br>        p256dh,<br>        auth,<br>        user_agent,<br>        vapid_key,           -- ← fixed: plain column name<br>        created_at,<br>        updated_at<br>    )<br>    VALUES (<br>        p_business_id,<br>        p_user_id,<br>        p_endpoint,<br>        p_p256dh,<br>        p_auth,<br>        p_user_agent,<br>        p_vapid_key,         -- ← fixed: bound parameter<br>        now(),<br>        now()<br>    )<br>    ON CONFLICT (endpoint) DO UPDATE<br>    SET<br>        business_id = EXCLUDED.business_id,<br>        user_id     = EXCLUDED.user_id,<br>        p256dh      = EXCLUDED.p256dh,<br>        auth        = EXCLUDED.auth,<br>        user_agent  = EXCLUDED.user_agent,<br>        vapid_key   = EXCLUDED.vapid_key,<br>        updated_at  = now()<br>    RETURNING * INTO v_row;<br><br>    RETURN to_jsonb(v_row);<br><br>EXCEPTION<br>    WHEN unique_violation THEN<br>        RAISE EXCEPTION 'push subscription already exists for endpoint %', p_endpoint;<br>    WHEN foreign_key_violation THEN<br>        RAISE EXCEPTION 'invalid business_id or user_id';<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
| delete_active_device_secure           | CREATE OR REPLACE FUNCTION public.delete_active_device_secure(p_id uuid, p_business_id uuid)<br> RETURNS void<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>BEGIN<br>    -- Set context for RLS<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br>    <br>    -- Delete the specific device, ensuring it belongs to this business<br>    DELETE FROM public.active_devices <br>    WHERE id = p_id AND business_id = p_business_id;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      