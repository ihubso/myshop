                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
| set_created_by_on_insert              | CREATE OR REPLACE FUNCTION public.set_created_by_on_insert()<br> RETURNS trigger<br> LANGUAGE plpgsql<br> SET search_path TO 'public'<br>AS $function$<br>BEGIN<br>    -- If created_by is NULL, set it from current setting<br>    IF NEW.created_by IS NULL THEN<br>        NEW.created_by = current_setting('app.current_user_id', TRUE)::UUID;<br>    END IF;<br>    RETURN NEW;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        