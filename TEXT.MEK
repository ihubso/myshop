                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
| insert_credit_sale_secure             | CREATE OR REPLACE FUNCTION public.insert_credit_sale_secure(p_record jsonb, p_user_id uuid, p_business_id uuid)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE v_result jsonb;<br>BEGIN<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br>    PERFORM set_config('app.current_user_id', p_user_id::text, false);<br>    <br>    INSERT INTO public.credit_sales (<br>        product_name, type, quantity, price, total_amount, payment_type,<br>        date_sold, customer_name, receipt_id, credit_balance, advance_payment,<br>        user_id, business_id, username, created_at<br>    ) VALUES (<br>        p_record->>'product_name', COALESCE(p_record->>'type', 'product'),<br>        COALESCE((p_record->>'quantity')::numeric, 1), COALESCE((p_record->>'price')::numeric, 0),<br>        COALESCE((p_record->>'total_amount')::numeric, 0), COALESCE(p_record->>'payment_type', 'Credit'),<br>        COALESCE((p_record->>'date_sold')::date, CURRENT_DATE), p_record->>'customer_name',<br>        p_record->>'receipt_id', COALESCE((p_record->>'credit_balance')::numeric, 0),<br>        COALESCE((p_record->>'advance_payment')::numeric, 0),<br>        p_user_id, p_business_id, COALESCE(p_record->>'username', 'Unknown'), NOW()<br>    ) RETURNING row_to_json(public.credit_sales.*) INTO v_result;<br>    RETURN v_result;<br>END; $function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              