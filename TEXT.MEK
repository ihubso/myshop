                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
| get_credit_sale_by_receipt_id_secure  | CREATE OR REPLACE FUNCTION public.get_credit_sale_by_receipt_id_secure(p_receipt_id text, p_business_id uuid)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE<br>    v_result jsonb;<br>BEGIN<br>    -- 1. Set context for this exact transaction<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br>    <br>    -- 2. Fetch the credit sale by receipt_id<br>    SELECT row_to_json(cs) INTO v_result<br>    FROM public.credit_sales cs<br>    WHERE cs.receipt_id = p_receipt_id<br>    LIMIT 1;<br>    <br>    RETURN v_result;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
| get_credit_sales_secure               | CREATE OR REPLACE FUNCTION public.get_credit_sales_secure(p_business_id uuid)<br> RETURNS SETOF credit_sales<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>BEGIN<br>    -- 1. Set context for this exact transaction<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br>    <br>    -- 2. Return all credit sales for this business, ordered by newest first<br>    RETURN QUERY <br>    SELECT * FROM public.credit_sales <br>    WHERE business_id = p_business_id <br>    ORDER BY created_at DESC;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
| get_customer_receipt_secure           | CREATE OR REPLACE FUNCTION public.get_customer_receipt_secure(p_receipt_id text, p_business_id uuid)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE<br>    v_result jsonb;<br>BEGIN<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br>    <br>    SELECT row_to_json(cr) INTO v_result<br>    FROM public.customer_receipts cr<br>    WHERE cr.receipt_id = p_receipt_id<br>    LIMIT 1;<br>    <br>    RETURN v_result;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
| get_customer_receipts_list_secure     | CREATE OR REPLACE FUNCTION public.get_customer_receipts_list_secure(p_business_id uuid)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE<br>    v_result jsonb;<br>BEGIN<br>    -- 1. Set context for this exact transaction<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br>    <br>    -- 2. Fetch only the needed columns, filtering out null/empty customer names<br>    SELECT jsonb_agg(row_to_json(s)) INTO v_result<br>    FROM (<br>        SELECT customer_name, id, product_name, date_sold<br>        FROM public.sales<br>        WHERE business_id = p_business_id<br>          AND customer_name IS NOT NULL<br>          AND TRIM(customer_name) != ''<br>        ORDER BY date_sold DESC<br>    ) s;<br>    <br>    -- 3. Return empty array if no results<br>    RETURN COALESCE(v_result, '[]'::jsonb);<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
| get_customer_transactions_secure      | CREATE OR REPLACE FUNCTION public.get_customer_transactions_secure(p_customer_name text, p_business_id uuid)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE<br>    v_sales jsonb;<br>    v_credits jsonb;<br>BEGIN<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br>    <br>    SELECT jsonb_agg(row_to_json(s)) INTO v_sales<br>    FROM (<br>        SELECT * FROM public.sales <br>        WHERE business_id = p_business_id AND customer_name = p_customer_name<br>        ORDER BY date_sold DESC<br>    ) s;<br>    <br>    SELECT jsonb_agg(row_to_json(c)) INTO v_credits<br>    FROM (<br>        SELECT * FROM public.credit_sales <br>        WHERE business_id = p_business_id AND customer_name = p_customer_name<br>        ORDER BY created_at DESC<br>    ) c;<br>    <br>    RETURN jsonb_build_object(<br>        'sales', COALESCE(v_sales, '[]'::jsonb),<br>        'credits', COALESCE(v_credits, '[]'::jsonb)<br>    );<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
| get_dashboard_data_secure             | CREATE OR REPLACE FUNCTION public.get_dashboard_data_secure(p_business_id uuid)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE<br>    v_stock jsonb;<br>    v_sales jsonb;<br>    v_start_prev_month date;<br>    v_end_today date;<br>BEGIN<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br><br>    v_start_prev_month := date_trunc('month', current_date - interval '1 month')::date;<br>    v_end_today := current_date;<br><br>    -- Stock<br>    SELECT jsonb_agg(row_to_json(s)) INTO v_stock<br>    FROM (<br>        SELECT id, name, quantity, type, business_id, cost_price, price<br>        FROM public.stock<br>        WHERE business_id = p_business_id<br>        ORDER BY name ASC<br>    ) s;<br><br>    -- Sales: NOW WITH created_at<br>    SELECT jsonb_agg(row_to_json(sl)) INTO v_sales<br>    FROM (<br>        SELECT <br>            id, product_name, quantity, price, total_amount, payment_type,<br>            username, business_id, type, date_sold, receipt_id, product_id,<br>            created_at                            -- 🔥 ADDED<br>        FROM public.sales<br>        WHERE business_id = p_business_id<br>          AND date_sold >= v_start_prev_month<br>          AND date_sold <= v_end_today<br>        ORDER BY created_at DESC<br>    ) sl;<br><br>    RETURN jsonb_build_object(<br>        'stock', COALESCE(v_stock, '[]'::jsonb),<br>        'sales', COALESCE(v_sales, '[]'::jsonb)<br>    );<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |
| get_exchange_products_secure          | CREATE OR REPLACE FUNCTION public.get_exchange_products_secure(p_business_id uuid)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE<br>    v_rows jsonb;<br>BEGIN<br>    IF p_business_id IS NULL THEN<br>        RAISE EXCEPTION 'BUSINESS_ID_REQUIRED';<br>    END IF;<br><br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br><br>    SELECT COALESCE(jsonb_agg(jsonb_build_object(<br>        'id',       s.id,<br>        'name',     s.name,<br>        'quantity', s.quantity,<br>        'price',    s.price,<br>        'type',     s.type,<br>        'category', s.category<br>    )), '[]'::jsonb)<br>    INTO v_rows<br>    FROM (<br>        SELECT id, name, quantity, price, type, category<br>        FROM public.stock<br>        WHERE business_id = p_business_id<br>          AND type = 'product'<br>          AND quantity > 0<br>        ORDER BY name ASC<br>    ) s;<br><br>    RETURN v_rows;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
| get_expenses_secure                   | CREATE OR REPLACE FUNCTION public.get_expenses_secure(p_business_id uuid)<br> RETURNS SETOF expenses<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>BEGIN<br>    -- 1. Set context for this exact transaction<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br>    <br>    -- 2. Return all expenses for this business, ordered by newest first<br>    RETURN QUERY <br>    SELECT * FROM public.expenses <br>    WHERE business_id = p_business_id <br>    ORDER BY date DESC;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
| get_filtered_combined_receipts_secure | CREATE OR REPLACE FUNCTION public.get_filtered_combined_receipts_secure(p_business_id uuid, p_receipt_id text DEFAULT NULL::text, p_customer_name text DEFAULT NULL::text, p_date date DEFAULT NULL::date, p_status text DEFAULT NULL::text, p_limit integer DEFAULT 30)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO ''<br>AS $function$<br>DECLARE<br>  v_limit    int := LEAST(GREATEST(COALESCE(p_limit, 30), 1), 60);<br>  v_rows     jsonb;<br>  v_total    int;<br>BEGIN<br>  -- ── Guards ────────────────────────────────────────────────────────<br>  IF p_business_id IS NULL THEN<br>    RAISE EXCEPTION 'BUSINESS_ID_REQUIRED' USING ERRCODE = '22004';<br>  END IF;<br><br>  -- ── Build the combined, deduped, normalized set once ──────────────<br>  WITH credit AS (<br>    SELECT<br>      'credit_sale'::text              AS type,<br>      COALESCE(cs.receipt_id,<br>               'CS-' \|\| left(cs.id::text, 8)) AS "receiptId",<br>      COALESCE(cs.customer_name, '')   AS "customerName",<br>      COALESCE(cs.date_sold, cs.created_at::date) AS "date",<br>      COALESCE(cs.total_amount, 0)     AS "amount",<br>      COALESCE(cs.paid_amount, 0)      AS "paidAmount",<br>      COALESCE(cs.credit_balance, 0)   AS "balance",<br>      COALESCE(cs.status, 'pending')   AS "status",<br>      COALESCE(cs.payment_type, 'Credit') AS "paymentType",<br>      COALESCE(cs.username, '')        AS "cashier",<br>      jsonb_build_object(<br>        'product_name',    cs.product_name,<br>        'quantity',        cs.quantity,<br>        'price',           cs.price,<br>        'advance_payment', cs.advance_payment,<br>        'payments',        cs.payments<br>      )                                AS "details",<br>      'credit_sales'::text             AS "source",<br>      cs.created_at                    AS "created_at",<br>      cs.id                            AS sort_id<br>    FROM public.credit_sales cs<br>    WHERE cs.business_id = p_business_id<br>      AND (p_receipt_id   IS NULL OR cs.receipt_id    ILIKE '%' \|\| p_receipt_id   \|\| '%')<br>      AND (p_customer_name IS NULL OR cs.customer_name ILIKE '%' \|\| p_customer_name \|\| '%')<br>      AND (p_date         IS NULL OR cs.date_sold     = p_date)<br>      AND (p_status       IS NULL OR cs.status        = p_status)<br>  ),<br>  receipts AS (<br>    SELECT<br>      'customer_receipt'::text         AS type,<br>      cr.receipt_id                    AS "receiptId",<br>      COALESCE(cr.customer_name, '')   AS "customerName",<br>      COALESCE(cr.date, cr.created_at::date) AS "date",<br>      COALESCE(cr.amount_paid, 0) + COALESCE(cr.balance_due, 0) AS "amount",<br>      COALESCE(cr.amount_paid, 0)      AS "paidAmount",<br>      COALESCE(cr.balance_due, 0)      AS "balance",<br>      CASE<br>        WHEN COALESCE(cr.balance_due, 0) > 0 THEN 'partial'<br>        ELSE 'completed'<br>      END                              AS "status",<br>      COALESCE(cr.payment_type_display, 'Cash') AS "paymentType",<br>      COALESCE(cr.cashier, '')         AS "cashier",<br>      jsonb_build_object(<br>        'items',           COALESCE(cr.items, '[]'::jsonb),<br>        'item_count',<br>          CASE<br>            WHEN cr.items IS NULL OR jsonb_typeof(cr.items) <> 'array' THEN 0<br>            ELSE jsonb_array_length(cr.items)<br>          END,<br>        'advance_payment', COALESCE(cr.advance_payment_amount, 0)<br>      )                                AS "details",<br>      'customer_receipts'::text        AS "source",<br>      cr.created_at                    AS "created_at",<br>      cr.id                            AS sort_id<br>    FROM public.customer_receipts cr<br>    WHERE cr.business_id = p_business_id<br>      AND (p_receipt_id   IS NULL OR cr.receipt_id    ILIKE '%' \|\| p_receipt_id   \|\| '%')<br>      AND (p_customer_name IS NULL OR cr.customer_name ILIKE '%' \|\| p_customer_name \|\| '%')<br>      AND (p_date         IS NULL OR cr.date          = p_date)<br>      -- status filter only applies to credit sales; ignore for receipts<br>      AND p_status IS NULL<br>  ),<br>  combined AS (<br>    SELECT * FROM credit<br>    UNION ALL<br>    SELECT * FROM receipts<br>  ),<br>  -- Dedupe by receiptId — prefer credit_sale if both exist, else whichever<br>  -- came first by created_at (matches your JS `seenReceiptIds` behavior)<br>  deduped AS (<br>    SELECT DISTINCT ON ("receiptId") *<br>    FROM combined<br>    ORDER BY "receiptId", "created_at" DESC<br>  ),<br>  sorted AS (<br>    SELECT * FROM deduped<br>    ORDER BY "created_at" DESC<br>  )<br>  SELECT<br>    COUNT(*)::int,<br>    COALESCE(<br>      (SELECT jsonb_agg(to_jsonb(s) - 'sort_id')<br>       FROM (SELECT * FROM sorted LIMIT v_limit) s),<br>      '[]'::jsonb<br>    )<br>  INTO v_total, v_rows<br>  FROM sorted;<br><br>  -- ── Response ──────────────────────────────────────────────────────<br>  RETURN jsonb_build_object(<br>    'data',     v_rows,<br>    'total',    v_total,<br>    'limit',    v_limit,<br>    'hasMore',  v_total > v_limit,<br>    'message',  CASE<br>                  WHEN v_total > v_limit<br>                    THEN 'Showing first ' \|\| v_limit \|\| ' of ' \|\| v_total \|\|<br>                         ' records. Please use the Date filter to narrow results.'<br>                  ELSE 'Showing all ' \|\| v_total \|\| ' records.'<br>                END<br>  );<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
| get_filtered_credit_sales_secure      | CREATE OR REPLACE FUNCTION public.get_filtered_credit_sales_secure(p_business_id uuid, p_customer_name text DEFAULT NULL::text, p_date date DEFAULT NULL::date, p_status text DEFAULT NULL::text, p_limit integer DEFAULT 30)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE<br>    result_data JSONB;<br>    current_user_id UUID;<br>    total_count INTEGER;<br>BEGIN<br>    -- 🔒 Verify caller's identity<br>    current_user_id := current_setting('app.current_user_id', true)::UUID;<br>    <br>    IF current_user_id IS NULL THEN<br>        RAISE EXCEPTION 'Unauthorized: No user context set';<br>    END IF;<br><br>    IF p_business_id IS NULL THEN<br>        RAISE EXCEPTION 'Invalid input: Business ID is required';<br>    END IF;<br><br>    IF NOT EXISTS (<br>        SELECT 1 FROM public.users <br>        WHERE id = current_user_id <br>        AND business_id = p_business_id<br>    ) THEN<br>        RAISE EXCEPTION 'Unauthorized: User does not belong to this business';<br>    END IF;<br><br>    IF p_limit > 30 THEN<br>        p_limit := 30;<br>    END IF;<br><br>    WITH filtered_credit_sales AS (<br>        SELECT <br>            cs.id,<br>            cs.product_name,<br>            cs.quantity,<br>            cs.price,<br>            cs.total_amount,<br>            cs.customer_name,<br>            cs.customer_phone,<br>            cs.advance_payment,<br>            cs.advance_payment_date,<br>            cs.credit_balance,<br>            cs.status,<br>            cs.related_sale_id,<br>            cs.paid_amount,<br>            cs.date_paid,<br>            cs.username,<br>            cs.type,<br>            cs.business_id,<br>            cs.date_sold,<br>            cs.payment_type,<br>            cs.created_at,<br>            cs.updated_at,<br>            cs.receipt_id,<br>            cs.user_id,<br>            -- ✅ Safe: Just return payments as text to avoid JSON errors<br>            cs.payments,<br>            EXTRACT(DAY FROM (NOW() - cs.created_at)) AS days_open,<br>            CASE <br>                WHEN cs.total_amount > 0 THEN <br>                    ROUND(((cs.paid_amount) / cs.total_amount) * 100, 2)<br>                ELSE 0<br>            END AS payment_progress<br>        FROM public.credit_sales cs<br>        WHERE cs.business_id = p_business_id<br>        AND (p_customer_name IS NULL OR cs.customer_name ILIKE '%' \|\| p_customer_name \|\| '%')<br>        AND (p_date IS NULL OR cs.date_sold = p_date)<br>        AND (p_status IS NULL OR cs.status = p_status)<br>        ORDER BY cs.created_at DESC<br>        LIMIT p_limit<br>    ),<br>    total_count_cte AS (<br>        SELECT COUNT(*) AS total<br>        FROM public.credit_sales cs<br>        WHERE cs.business_id = p_business_id<br>        AND (p_customer_name IS NULL OR cs.customer_name ILIKE '%' \|\| p_customer_name \|\| '%')<br>        AND (p_date IS NULL OR cs.date_sold = p_date)<br>        AND (p_status IS NULL OR cs.status = p_status)<br>    )<br>    SELECT <br>        (SELECT total FROM total_count_cte) INTO total_count;<br>    <br>    SELECT jsonb_build_object(<br>        'data', COALESCE((SELECT jsonb_agg(row_to_json(filtered_credit_sales)) FROM filtered_credit_sales), '[]'::jsonb),<br>        'total', total_count,<br>        'limit', p_limit,<br>        'has_more', CASE WHEN total_count > p_limit THEN true ELSE false END,<br>        'message', CASE <br>            WHEN total_count > p_limit THEN <br>                'Showing ' \|\| p_limit \|\| ' of ' \|\| total_count \|\| ' records. Please use date filters to narrow results.'<br>            ELSE <br>                'Showing all ' \|\| total_count \|\| ' records.'<br>        END<br>    ) INTO result_data;<br><br>    RETURN result_data;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
| get_filtered_customer_receipts_secure | CREATE OR REPLACE FUNCTION public.get_filtered_customer_receipts_secure(p_business_id uuid, p_receipt_id text DEFAULT NULL::text, p_customer_name text DEFAULT NULL::text, p_date date DEFAULT NULL::date, p_limit integer DEFAULT 30)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE<br>    result_data JSONB;<br>    current_user_id UUID;<br>    total_count INTEGER;<br>BEGIN<br>    -- 🔒 Verify caller's identity<br>    current_user_id := current_setting('app.current_user_id', true)::UUID;<br>    <br>    IF current_user_id IS NULL THEN<br>        RAISE EXCEPTION 'Unauthorized: No user context set';<br>    END IF;<br><br>    -- 🔒 Validate business access<br>    IF p_business_id IS NULL THEN<br>        RAISE EXCEPTION 'Invalid input: Business ID is required';<br>    END IF;<br><br>    -- 🔒 BUSINESS ISOLATION<br>    IF NOT EXISTS (<br>        SELECT 1 FROM public.users <br>        WHERE id = current_user_id <br>        AND business_id = p_business_id<br>    ) THEN<br>        RAISE EXCEPTION 'Unauthorized: User does not belong to this business';<br>    END IF;<br><br>    -- 🔒 Enforce max 30 records<br>    IF p_limit > 30 THEN<br>        p_limit := 30;<br>    END IF;<br><br>    -- 🔒 Build query with filters<br>    WITH filtered_receipts AS (<br>        SELECT <br>            cr.id,<br>            cr.receipt_id,<br>            cr.date,<br>            cr.customer_name,<br>            cr.cashier,<br>            cr.customer_phone,<br>            cr.items,<br>            cr.amount_paid,<br>            cr.balance_due,<br>            cr.advance_payment_amount,<br>            cr.advance_payment_date,<br>            cr.payment_type_display,<br>            cr.business_id,<br>            cr.source,<br>            cr.created_at,<br>            cr.updated_at,<br>            cr.advance_payment,<br>            cr.user_id,<br>            -- Calculate receipt total from items JSONB<br>            COALESCE(<br>                (SELECT SUM((item->>'price')::NUMERIC) <br>                 FROM jsonb_array_elements(cr.items) AS item),<br>                0<br>            ) AS receipt_total,<br>            -- Count items in receipt<br>            COALESCE(<br>                (SELECT COUNT(*) <br>                 FROM jsonb_array_elements(cr.items)),<br>                0<br>            ) AS item_count,<br>            -- Check if receipt has refund items<br>            EXISTS (<br>                SELECT 1 <br>                FROM jsonb_array_elements(cr.items) AS item<br>                WHERE item->>'paymentType' = 'Refund' <br>                OR item->>'type' = 'Refund'<br>            ) AS has_refund<br>        FROM public.customer_receipts cr<br>        WHERE cr.business_id = p_business_id<br>        AND (p_receipt_id IS NULL OR cr.receipt_id ILIKE '%' \|\| p_receipt_id \|\| '%')<br>        AND (p_customer_name IS NULL OR cr.customer_name ILIKE '%' \|\| p_customer_name \|\| '%')<br>        AND (p_date IS NULL OR cr.date = p_date)<br>        ORDER BY cr.date DESC, cr.created_at DESC<br>        LIMIT p_limit<br>    ),<br>    total_count_cte AS (<br>        SELECT COUNT(*) AS total<br>        FROM public.customer_receipts cr<br>        WHERE cr.business_id = p_business_id<br>        AND (p_receipt_id IS NULL OR cr.receipt_id ILIKE '%' \|\| p_receipt_id \|\| '%')<br>        AND (p_customer_name IS NULL OR cr.customer_name ILIKE '%' \|\| p_customer_name \|\| '%')<br>        AND (p_date IS NULL OR cr.date = p_date)<br>    )<br>    SELECT <br>        (SELECT total FROM total_count_cte) INTO total_count;<br>    <br>    SELECT jsonb_build_object(<br>        'data', COALESCE((SELECT jsonb_agg(row_to_json(filtered_receipts)) FROM filtered_receipts), '[]'::jsonb),<br>        'total', total_count,<br>        'limit', p_limit,<br>        'has_more', CASE WHEN total_count > p_limit THEN true ELSE false END,<br>        'message', CASE <br>            WHEN total_count > p_limit THEN <br>                'Showing ' \|\| p_limit \|\| ' of ' \|\| total_count \|\| ' records. Please use date filters to narrow results.'<br>            ELSE <br>                'Showing all ' \|\| total_count \|\| ' records.'<br>        END<br>    ) INTO result_data;<br><br>    RETURN result_data;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
| get_filtered_sales_receipts_secure    | CREATE OR REPLACE FUNCTION public.get_filtered_sales_receipts_secure(p_business_id uuid, p_start_date date DEFAULT NULL::date, p_end_date date DEFAULT NULL::date, p_limit integer DEFAULT 100, p_offset integer DEFAULT 0)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE<br>    result_data JSONB;<br>    current_user_id UUID;<br>BEGIN<br>    -- 🔒 Verify caller's identity<br>    current_user_id := current_setting('app.current_user_id', true)::UUID;<br>    <br>    IF current_user_id IS NULL THEN<br>        RAISE EXCEPTION 'Unauthorized: No user context set';<br>    END IF;<br><br>    -- 🔒 Validate business access<br>    IF p_business_id IS NULL THEN<br>        RAISE EXCEPTION 'Invalid input: Business ID is required';<br>    END IF;<br><br>    -- 🔒 BUSINESS ISOLATION: User must belong to this business<br>    IF NOT EXISTS (<br>        SELECT 1 FROM public.users <br>        WHERE id = current_user_id <br>        AND business_id = p_business_id<br>    ) THEN<br>        RAISE EXCEPTION 'Unauthorized: User does not belong to this business';<br>    END IF;<br><br>    -- 🔒 Build and execute query with date filtering<br>    WITH filtered_sales AS (<br>        SELECT <br>            s.id,<br>            s.receipt_id,<br>            s.product_name,<br>            s.quantity,<br>            s.price,<br>            s.total_amount,<br>            s.payment_type,<br>            s.customer_name,<br>            s.customer_phone,<br>            s.type,<br>            s.username,<br>            s.business_id,<br>            s.date_sold,<br>            s.created_at,<br>            s.updated_at,<br>            s.credit_balance,<br>            s.amount_paid,<br>            s.balance_due,<br>            s.advance_payment,<br>            s.advance_payment_date,<br>            s.notes,<br>            s.metadata,<br>            s.category,<br>            s.unit_price,<br>            s.total_price,<br>            s.subtotal,<br>            -- Calculate profit margin if cost_price exists<br>            CASE <br>                WHEN s.price IS NOT NULL AND s.price > 0 THEN <br>                    ROUND(((s.price - s.cost_price) / s.price) * 100, 2)<br>                ELSE NULL<br>            END AS profit_margin<br>        FROM public.sales s<br>        WHERE s.business_id = p_business_id<br>        AND (p_start_date IS NULL OR s.date_sold >= p_start_date)<br>        AND (p_end_date IS NULL OR s.date_sold <= p_end_date)<br>        ORDER BY s.date_sold DESC, s.created_at DESC<br>        LIMIT p_limit<br>        OFFSET p_offset<br>    ),<br>    total_count AS (<br>        SELECT COUNT(*) AS total<br>        FROM public.sales s<br>        WHERE s.business_id = p_business_id<br>        AND (p_start_date IS NULL OR s.date_sold >= p_start_date)<br>        AND (p_end_date IS NULL OR s.date_sold <= p_end_date)<br>    )<br>    SELECT jsonb_build_object(<br>        'data', COALESCE((SELECT jsonb_agg(row_to_json(filtered_sales)) FROM filtered_sales), '[]'::jsonb),<br>        'total', COALESCE((SELECT total FROM total_count), 0),<br>        'limit', p_limit,<br>        'offset', p_offset<br>    ) INTO result_data;<br><br>    RETURN result_data;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
| get_grouped_subcategories             | CREATE OR REPLACE FUNCTION public.get_grouped_subcategories(p_business_id uuid, p_year integer)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE<br>    v_result  jsonb;<br>    v_y0      date;<br>    v_y1      date;<br>BEGIN<br>    IF p_business_id IS NULL THEN<br>        RAISE EXCEPTION 'BUSINESS_ID_REQUIRED';<br>    END IF;<br>    IF p_year IS NULL OR p_year < 2000 OR p_year > 2100 THEN<br>        RAISE EXCEPTION 'INVALID_YEAR';<br>    END IF;<br><br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br><br>    v_y0 := make_date(p_year,     1, 1);<br>    v_y1 := make_date(p_year + 1, 1, 1);<br><br>    WITH<br>    -- 1. Units sold per product name (this year)<br>    sales_agg AS (<br>        SELECT LOWER(sa.product_name)         AS pname,<br>               COUNT(*)                       AS sales_count,<br>               COALESCE(SUM(sa.quantity), 0)  AS units_sold,<br>               COALESCE(SUM(sa.total_amount),0) AS revenue<br>          FROM public.sales sa<br>         WHERE sa.business_id   = p_business_id<br>           AND sa.date_sold::date >= v_y0<br>           AND sa.date_sold::date <  v_y1<br>         GROUP BY LOWER(sa.product_name)<br>    ),<br><br>    -- 2. Every stock item joined with its sales numbers<br>    items AS (<br>        SELECT<br>            s.id,<br>            s.name,<br>            s.category,<br>            s.subcategory,<br>            s.quantity,<br>            s.price,<br>            s.cost_price,<br>            s.image,<br>            s.type,<br>            COALESCE(sa.units_sold,  0) AS units_sold,<br>            COALESCE(sa.revenue,     0) AS revenue,<br>            COALESCE(sa.sales_count, 0) AS sales_count<br>          FROM public.stock s<br>          LEFT JOIN sales_agg sa ON LOWER(s.name) = sa.pname<br>         WHERE s.business_id = p_business_id<br>    ),<br><br>    -- 3. Group items into subcategory buckets<br>    grouped AS (<br>        SELECT<br>            COALESCE(NULLIF(TRIM(subcategory), ''), '#') AS subcategory,<br>            jsonb_agg(<br>                jsonb_build_object(<br>                    'id',          id,<br>                    'name',        name,<br>                    'category',    category,<br>                    'quantity',    quantity,<br>                    'price',       price,<br>                    'cost_price',  cost_price,<br>                    'image',   image,<br>                    'type',        type,<br>                    'unitsSold',   units_sold,<br>                    'revenue',     revenue,<br>                    'salesCount',  sales_count<br>                )<br>                ORDER BY name<br>            ) AS items,<br>            COUNT(*)                              AS items_count,<br>            COALESCE(SUM(quantity), 0)            AS total_qty,<br>            COALESCE(SUM(price * quantity), 0)    AS total_stock_value,<br>            COALESCE(SUM(units_sold), 0)          AS total_units_sold,<br>            COALESCE(SUM(revenue), 0)             AS total_revenue<br>          FROM items<br>         GROUP BY COALESCE(NULLIF(TRIM(subcategory), ''), '#')<br>    ),<br><br>    -- 4. Build the response array<br>    payload AS (<br>        SELECT jsonb_agg(<br>            jsonb_build_object(<br>                'subcategory', subcategory,<br>                'totals', jsonb_build_object(<br>                    'itemsCount',      items_count,<br>                    'totalQty',        total_qty,<br>                    'totalStockValue', total_stock_value,<br>                    'totalUnitsSold',  total_units_sold,<br>                    'totalRevenue',    total_revenue<br>                ),<br>                'items', items<br>            )<br>            ORDER BY subcategory<br>        ) AS arr<br>          FROM grouped<br>    )<br>    SELECT jsonb_build_object(<br>        'year',         p_year,<br>        'subcategories', COALESCE(arr, '[]'::jsonb)<br>    )<br>    INTO v_result<br>    FROM payload;<br><br>    RETURN v_result;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
| get_loan_by_id_secure                 | CREATE OR REPLACE FUNCTION public.get_loan_by_id_secure(p_id uuid, p_business_id uuid)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE<br>    v_result jsonb;<br>BEGIN<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br>    <br>    SELECT row_to_json(l) INTO v_result<br>    FROM public.loans l<br>    WHERE l.id = p_id<br>    LIMIT 1;<br>    <br>    RETURN v_result;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
| get_loans_secure                      | CREATE OR REPLACE FUNCTION public.get_loans_secure(p_business_id uuid)<br> RETURNS SETOF loans<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>BEGIN<br>    -- 1. Set context for this exact transaction<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br>    <br>    -- 2. Return all loans for this business, ordered by newest first<br>    RETURN QUERY <br>    SELECT * FROM public.loans <br>    WHERE business_id = p_business_id <br>    ORDER BY created_at DESC;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
| get_notes_secure                      | CREATE OR REPLACE FUNCTION public.get_notes_secure(p_user_id uuid)<br> RETURNS SETOF notes<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>BEGIN<br>    PERFORM set_config('app.current_user_id', p_user_id::text, false);<br>    <br>    RETURN QUERY <br>    SELECT * FROM public.notes <br>    WHERE user_id = p_user_id <br>    ORDER BY updated_at DESC;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |
| get_notification_secure               | CREATE OR REPLACE FUNCTION public.get_notification_secure(p_notification_id uuid, p_business_id uuid)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE<br>    v_notification public.notifications;<br>BEGIN<br>    -- Set context for this exact transaction<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br>    <br>    -- Fetch the notification by ID<br>    SELECT * INTO v_notification <br>    FROM public.notifications <br>    WHERE id = p_notification_id;<br>    <br>    RETURN row_to_json(v_notification);<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
| get_notifications_secure              | CREATE OR REPLACE FUNCTION public.get_notifications_secure(p_business_id uuid)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE<br>    result JSONB;<br>    tasks_json JSONB;<br>    reminders_json JSONB;<br>    stock_json JSONB;<br>    notif_json JSONB;<br>BEGIN<br>    -- 1. Get tasks (pending and in-progress)<br>    SELECT COALESCE(jsonb_agg(t), '[]'::jsonb)<br>    INTO tasks_json<br>    FROM (<br>        SELECT <br>            id,<br>            'task' as type,<br>            title,<br>            description as message,<br>            due_date as date,<br>            status,<br>            created_at,<br>            assigned_to,<br>            business_id,<br>            'task' as notification_type,<br>            jsonb_build_object(<br>                'title', title,<br>                'description', description,<br>                'assigned_to', assigned_to,<br>                'due_date', due_date,<br>                'status', status<br>            ) as data<br>        FROM tasks<br>        WHERE business_id = p_business_id<br>        AND status != 'completed'<br>        ORDER BY created_at DESC<br>        LIMIT 50<br>    ) t;<br><br>    -- 2. Get reminders (pending)<br>    SELECT COALESCE(jsonb_agg(r), '[]'::jsonb)<br>    INTO reminders_json<br>    FROM (<br>        SELECT <br>            id,<br>            'reminder' as type,<br>            title,<br>            message,<br>            date,<br>            status,<br>            created_at,<br>            business_id,<br>            'reminder' as notification_type,<br>            jsonb_build_object(<br>                'title', title,<br>                'message', message,<br>                'date', date,<br>                'status', status<br>            ) as data<br>        FROM reminders<br>        WHERE business_id = p_business_id<br>        AND status != 'completed'<br>        ORDER BY created_at DESC<br>        LIMIT 50<br>    ) r;<br><br>    -- 3. Get low stock items<br>    SELECT COALESCE(jsonb_agg(s), '[]'::jsonb)<br>    INTO stock_json<br>    FROM (<br>        SELECT <br>            id,<br>            'low_stock' as type,<br>            name,<br>            quantity,<br>            image,<br>            'low_stock' as notification_type,<br>            jsonb_build_object(<br>                'id', id,<br>                'name', name,<br>                'quantity', quantity,<br>                'image', image<br>            ) as data<br>        FROM stock<br>        WHERE business_id = p_business_id<br>        AND quantity <= 3<br>        AND hasbeensold = true<br>        ORDER BY quantity ASC<br>        LIMIT 20<br>    ) s;<br><br>    -- 🔥 4. GET NOTIFICATIONS FROM NOTIFICATIONS TABLE (THIS WAS MISSING!)<br>    SELECT COALESCE(jsonb_agg(n), '[]'::jsonb)<br>    INTO notif_json<br>    FROM (<br>        SELECT <br>            id,<br>            type,<br>            event,<br>            title,<br>            message,<br>            created_at as date,<br>            is_read as status,<br>            username,<br>            recipient_username,<br>            business_id,<br>            type as notification_type,<br>            COALESCE(data, '{}'::jsonb) as data,<br>            promoter_name,<br>            user_id,<br>            updated_at<br>        FROM notifications<br>        WHERE business_id = p_business_id<br>        -- Include all important notification types<br>        AND type IN (<br>            'daily_combined_report',<br>            'manager_promoted', <br>            'manager-promoted',<br>            'outstanding_balances_reminder',<br>            'credit_sale_reminder',<br>            'loan_reminder',<br>            'task_reminder',<br>            'stock_alert'<br>        )<br>        -- Only get notifications from the last 30 days<br>        AND created_at >= NOW() - INTERVAL '30 days'<br>        ORDER BY created_at DESC<br>        LIMIT 100<br>    ) n;<br><br>    -- Combine all into one result<br>    result = jsonb_build_object(<br>        'tasks', tasks_json,<br>        'reminders', reminders_json,<br>        'low_stock', stock_json,<br>        'notifications', notif_json  -- 🔥 NOW INCLUDED!<br>    );<br><br>    RETURN result;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
| get_personal_loans_secure             | CREATE OR REPLACE FUNCTION public.get_personal_loans_secure(p_business_id uuid)<br> RETURNS SETOF loans<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>BEGIN<br>    -- 1. Set context for this exact transaction<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br>    <br>    -- 2. Return ONLY personal loans for this business, ordered by newest first<br>    RETURN QUERY <br>    SELECT * FROM public.loans <br>    WHERE business_id = p_business_id <br>      AND loan_type = 'personal'<br>    ORDER BY created_at DESC;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
| get_product_type                      | CREATE OR REPLACE FUNCTION public.get_product_type(p_product_id uuid, p_product_name text, p_business_id uuid)<br> RETURNS text<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE<br>    v_type TEXT;<br>BEGIN<br>    -- Try by product_id first<br>    IF p_product_id IS NOT NULL THEN<br>        SELECT type INTO v_type<br>        FROM public.stock<br>        WHERE id = p_product_id<br>        AND business_id = p_business_id;<br>    END IF;<br>    <br>    -- If not found, try by product_name<br>    IF v_type IS NULL AND p_product_name IS NOT NULL THEN<br>        SELECT type INTO v_type<br>        FROM public.stock<br>        WHERE name ILIKE p_product_name<br>        AND business_id = p_business_id<br>        LIMIT 1;<br>    END IF;<br>    <br>    -- Default to 'product'<br>    RETURN COALESCE(v_type, 'product');<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
| get_reminders_secure                  | CREATE OR REPLACE FUNCTION public.get_reminders_secure(p_business_id uuid)<br> RETURNS SETOF reminders<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>BEGIN<br>    -- 1. Set context for this exact transaction<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br>    <br>    -- 2. Return all reminders for this business, ordered by newest first<br>    RETURN QUERY <br>    SELECT * FROM public.reminders <br>    WHERE business_id = p_business_id <br>    ORDER BY created_at DESC;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
| get_sale_by_id_secure                 | CREATE OR REPLACE FUNCTION public.get_sale_by_id_secure(p_id text, p_business_id uuid)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE<br>    v_result jsonb;<br>BEGIN<br>    -- 1. Set context for this exact transaction<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br>    <br>    -- 2. Fetch the sale by EITHER the UUID (cast to text) OR the receipt_id<br>    SELECT row_to_json(s) INTO v_result<br>    FROM public.sales s<br>    WHERE s.business_id = p_business_id<br>      AND (s.id::text = p_id OR s.receipt_id = p_id)<br>    LIMIT 1;<br>    <br>    RETURN v_result;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
| get_sales_by_date_range_secure        | CREATE OR REPLACE FUNCTION public.get_sales_by_date_range_secure(p_business_id uuid, p_start_date text, p_end_date text)<br> RETURNS SETOF sales<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>BEGIN<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br><br>    RETURN QUERY<br>    SELECT s.*<br>    FROM public.sales s<br>    WHERE s.business_id = p_business_id<br>      AND s.date_sold >= p_start_date::date<br>      AND s.date_sold <= p_end_date::date<br>    ORDER BY s.date_sold DESC, s.created_at DESC;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
| get_sales_by_receipt_id_secure        | CREATE OR REPLACE FUNCTION public.get_sales_by_receipt_id_secure(p_receipt_id text, p_business_id uuid)<br> RETURNS SETOF sales<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>BEGIN<br>    -- 1. Set context for this exact transaction<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br>    <br>    -- 2. Return all sales for this receipt_id, ordered by creation time<br>    RETURN QUERY <br>    SELECT * FROM public.sales <br>    WHERE business_id = p_business_id AND receipt_id = p_receipt_id<br>    ORDER BY created_at ASC;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
| get_stock_for_business                | CREATE OR REPLACE FUNCTION public.get_stock_for_business(p_business_id uuid)<br> RETURNS SETOF stock<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>BEGIN<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br><br>    RETURN QUERY<br>    SELECT * FROM public.stock<br>    WHERE business_id = p_business_id<br>    ORDER BY name ASC;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
| get_stock_history_secure              | CREATE OR REPLACE FUNCTION public.get_stock_history_secure(p_business_id uuid, p_start_date text DEFAULT NULL::text, p_end_date text DEFAULT NULL::text)<br> RETURNS SETOF stock_history<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>BEGIN<br>    -- 1. Set context for this exact transaction<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br>    <br>    -- 2. Return history with optional date filtering, ordered by newest first<br>    IF p_start_date IS NOT NULL AND p_end_date IS NOT NULL THEN<br>        RETURN QUERY <br>        SELECT * FROM public.stock_history <br>        WHERE business_id = p_business_id <br>          AND timestamp >= p_start_date::timestamptz <br>          AND timestamp <= p_end_date::timestamptz<br>        ORDER BY timestamp DESC;<br>    ELSE<br>        RETURN QUERY <br>        SELECT * FROM public.stock_history <br>        WHERE business_id = p_business_id <br>        ORDER BY timestamp DESC;<br>    END IF;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
| get_subcategory_analytics             | CREATE OR REPLACE FUNCTION public.get_subcategory_analytics(p_business_id uuid, p_subcategory text, p_year integer)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE<br>    v_items    jsonb;<br>    v_sales    jsonb;<br>    v_history  jsonb;<br>    v_summary  jsonb;<br>    v_result   jsonb;<br>    v_y0       date;<br>    v_y1       date;<br>    v_ts0      timestamptz;<br>    v_ts1      timestamptz;<br>BEGIN<br>    -- ── Guards ────────────────────────────────────────────────<br>    IF p_business_id IS NULL THEN<br>        RAISE EXCEPTION 'BUSINESS_ID_REQUIRED';<br>    END IF;<br>    IF p_subcategory IS NULL OR TRIM(p_subcategory) = '' THEN<br>        RAISE EXCEPTION 'SUBCATEGORY_REQUIRED';<br>    END IF;<br>    IF p_year IS NULL OR p_year < 2000 OR p_year > 2100 THEN<br>        RAISE EXCEPTION 'INVALID_YEAR';<br>    END IF;<br><br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br><br>    v_y0  := make_date(p_year,     1, 1);<br>    v_y1  := make_date(p_year + 1, 1, 1);<br>    v_ts0 := make_timestamptz(p_year,     1, 1, 0, 0, 0);<br>    v_ts1 := make_timestamptz(p_year + 1, 1, 1, 0, 0, 0);<br><br>    -- ── 1. Items in this subcategory ──────────────────────────<br>    SELECT COALESCE(jsonb_agg(to_jsonb(s)), '[]'::jsonb)<br>      INTO v_items<br>      FROM public.stock s<br>     WHERE s.business_id  = p_business_id<br>       AND s.subcategory  = p_subcategory;<br><br>    -- ── 2. Sales this year whose product_name matches an item ─<br>    SELECT COALESCE(jsonb_agg(to_jsonb(sa)), '[]'::jsonb)<br>      INTO v_sales<br>      FROM public.sales sa<br>     WHERE sa.business_id = p_business_id<br>       AND sa.date_sold::date >= v_y0<br>       AND sa.date_sold::date <  v_y1<br>       AND EXISTS (<br>           SELECT 1<br>             FROM public.stock st<br>            WHERE st.business_id = p_business_id<br>              AND st.subcategory = p_subcategory<br>              AND LOWER(st.name) = LOWER(sa.product_name)<br>       );<br><br>    -- ── 3. History this year for those items ──────────────────<br>    SELECT COALESCE(jsonb_agg(to_jsonb(sh)), '[]'::jsonb)<br>      INTO v_history<br>      FROM public.stock_history sh<br>     WHERE sh.business_id = p_business_id<br>       AND sh.timestamp  >= v_ts0<br>       AND sh.timestamp  <  v_ts1<br>       AND EXISTS (<br>           SELECT 1<br>             FROM public.stock st<br>            WHERE st.business_id = p_business_id<br>              AND st.subcategory = p_subcategory<br>              AND st.name        = sh.item_name<br>       );<br><br>    -- ── 4. Per-item metrics + summary ─────────────────────────<br>    WITH items AS (<br>        SELECT id, name, quantity, price, cost_price<br>          FROM public.stock<br>         WHERE business_id = p_business_id<br>           AND subcategory = p_subcategory<br>    ),<br>    sales_agg AS (<br>        -- Aggregate once instead of a subquery per item<br>        SELECT LOWER(sa.product_name)   AS pname,<br>               COUNT(*)                 AS sales_count,<br>               COALESCE(SUM(sa.quantity), 0)     AS units_sold,<br>               COALESCE(SUM(sa.total_amount), 0) AS revenue<br>          FROM public.sales sa<br>         WHERE sa.business_id = p_business_id<br>           AND sa.date_sold::date >= v_y0<br>           AND sa.date_sold::date <  v_y1<br>         GROUP BY LOWER(sa.product_name)<br>    ),<br>    metrics AS (<br>        SELECT<br>            i.id,<br>            i.name,<br>            i.quantity,<br>            i.price,<br>            i.cost_price,<br>            COALESCE(s.sales_count, 0) AS sales_count,<br>            COALESCE(s.units_sold,  0) AS units_sold,<br>            COALESCE(s.revenue,     0) AS revenue,<br>            -- COGS this year for this item<br>            COALESCE(s.units_sold, 0) * COALESCE(i.cost_price, 0) AS cogs,<br>            -- Stock value (retail + cost)<br>            COALESCE(i.price, 0)      * COALESCE(i.quantity, 0) AS stock_retail_value,<br>            COALESCE(i.cost_price, 0) * COALESCE(i.quantity, 0) AS stock_cost_value<br>          FROM items i<br>          LEFT JOIN sales_agg s ON LOWER(i.name) = s.pname<br>    )<br>    SELECT jsonb_build_object(<br>        'itemsCount',           COUNT(*),<br>        'totalStockQty',        COALESCE(SUM(quantity), 0),<br>        'totalStockRetailVal',  COALESCE(SUM(stock_retail_value), 0),<br>        'totalStockCostVal',    COALESCE(SUM(stock_cost_value), 0),<br>        'totalSalesCount',      COALESCE(SUM(sales_count), 0),<br>        'totalUnitsSold',       COALESCE(SUM(units_sold), 0),<br>        'totalRevenue',         COALESCE(SUM(revenue), 0),<br>        'totalCOGS',            COALESCE(SUM(cogs), 0),<br>        'grossProfit',          COALESCE(SUM(revenue), 0) - COALESCE(SUM(cogs), 0),<br>        'profitMargin',         CASE<br>                                    WHEN COALESCE(SUM(revenue), 0) > 0<br>                                    THEN ROUND(<br>                                        ( (COALESCE(SUM(revenue),0) - COALESCE(SUM(cogs),0))<br>                                          / COALESCE(SUM(revenue),1) ) * 100,<br>                                        2)<br>                                    ELSE 0<br>                                END,<br>        'lowStockCount',        COUNT(*) FILTER (WHERE quantity < 3 AND quantity > 0),<br>        'outOfStockCount',      COUNT(*) FILTER (WHERE quantity = 0),<br>        'itemsWithNoSales',     COALESCE(<br>                                    jsonb_agg(name) FILTER (WHERE units_sold = 0 AND name IS NOT NULL),<br>                                    '[]'::jsonb<br>                                ),<br>        'bestSeller',           (SELECT jsonb_build_object(<br>                                            'name',       name,<br>                                            'unitsSold',  units_sold,<br>                                            'revenue',    revenue<br>                                        )<br>                                   FROM metrics<br>                                  WHERE units_sold > 0<br>                                  ORDER BY units_sold DESC, revenue DESC<br>                                  LIMIT 1),<br>        'worstSeller',          (SELECT jsonb_build_object(<br>                                            'name',       name,<br>                                            'unitsSold',  units_sold,<br>                                            'revenue',    revenue<br>                                        )<br>                                   FROM metrics<br>                                  WHERE units_sold > 0<br>                                  ORDER BY units_sold ASC, revenue ASC<br>                                  LIMIT 1),<br>        'topRevenue',           (SELECT jsonb_build_object(<br>                                            'name',       name,<br>                                            'revenue',    revenue<br>                                        )<br>                                   FROM metrics<br>                                  WHERE revenue > 0<br>                                  ORDER BY revenue DESC<br>                                  LIMIT 1),<br>        'perItem',              (SELECT COALESCE(jsonb_agg(jsonb_build_object(<br>                                            'id',           id,<br>                                            'name',         name,<br>                                            'quantity',     quantity,<br>                                            'price',        price,<br>                                            'cost_price',   cost_price,<br>                                            'salesCount',   sales_count,<br>                                            'unitsSold',    units_sold,<br>                                            'revenue',      revenue,<br>                                            'cogs',         cogs,<br>                                            'profit',       revenue - cogs<br>                                        )), '[]'::jsonb)<br>                                   FROM metrics)<br>    )<br>    INTO v_summary<br>    FROM metrics;<br><br>    -- ── 5. Bundle everything ──────────────────────────────────<br>    v_result := jsonb_build_object(<br>        'subcategory', p_subcategory,<br>        'year',        p_year,<br>        'items',       v_items,<br>        'sales',       v_sales,<br>        'history',     v_history,<br>        'summary',     v_summary<br>    );<br><br>    RETURN v_result;<br>END;<br>$function$<br> |
| get_tasks_secure                      | CREATE OR REPLACE FUNCTION public.get_tasks_secure(p_business_id uuid)<br> RETURNS SETOF tasks<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>BEGIN<br>    -- 1. Set context for this exact transaction<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br>    <br>    -- 2. Return all tasks for this business, ordered by newest first<br>    RETURN QUERY <br>    SELECT * FROM public.tasks <br>    WHERE business_id = p_business_id <br>    ORDER BY created_at DESC;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
| get_transaction_detail_secure         | CREATE OR REPLACE FUNCTION public.get_transaction_detail_secure(p_id text, p_type text, p_business_id uuid)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE<br>    v_result jsonb;<br>BEGIN<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br>    <br>    IF p_type = 'sale' OR p_type = 'receipt' THEN<br>        SELECT row_to_json(s) INTO v_result<br>        FROM public.sales s<br>        WHERE s.business_id = p_business_id AND s.receipt_id = p_id<br>        LIMIT 1;<br>    ELSIF p_type = 'credit' THEN<br>        SELECT row_to_json(c) INTO v_result<br>        FROM public.credit_sales c<br>        WHERE c.business_id = p_business_id AND c.id::text = p_id<br>        LIMIT 1;<br>    END IF;<br>    <br>    RETURN v_result;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
| get_user_by_email_secure              | CREATE OR REPLACE FUNCTION public.get_user_by_email_secure(p_email text)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE v_result jsonb;<br>BEGIN<br>    SELECT row_to_json(u) INTO v_result FROM public.users u WHERE u.email = p_email LIMIT 1;<br>    RETURN v_result;<br>END; $function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              