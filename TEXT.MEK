                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
| insert_sale_secure                    | CREATE OR REPLACE FUNCTION public.insert_sale_secure(p_record jsonb, p_user_id uuid, p_business_id uuid)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE<br>    v_result jsonb;<br>    v_id     uuid;<br>BEGIN<br>    -- 🔒 Set session context for any downstream triggers / RLS helpers<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br>    PERFORM set_config('app.current_user_id',     p_user_id::text,     false);<br><br>    -- Use client-generated id if present, otherwise generate<br>    v_id := COALESCE(NULLIF(p_record->>'id', '')::uuid, gen_random_uuid());<br><br>    INSERT INTO public.sales (<br>        id,<br>        product_name,<br>        type,<br>        quantity,<br>        price,<br>        tax_rate,<br>        tax_amount,<br>        total_amount,<br>        amount_paid,<br>        credit_balance,<br>        payment_type,<br>        date_sold,<br>        customer_name,<br>        customer_phone,<br>        mobile_money_type,<br>        hybrid_breakdown,<br>        advance_payment,<br>        advance_payment_date,<br>        credit_status,<br>        receipt_id,<br>        product_id,<br>        username,<br>        user_id,        -- 🔥 FORCED<br>        business_id,    -- 🔥 FORCED<br>        created_at<br>    ) VALUES (<br>        v_id,<br>        p_record->>'product_name',<br>        COALESCE(NULLIF(p_record->>'type', ''), 'product'),<br>        COALESCE(ROUND((p_record->>'quantity')::numeric), 1)::integer,<br>        COALESCE((p_record->>'price')::numeric, 0),<br>        COALESCE((p_record->>'tax_rate')::numeric, 0),<br>        COALESCE((p_record->>'tax_amount')::numeric, 0),<br>        COALESCE((p_record->>'total_amount')::numeric, 0),<br>        COALESCE((p_record->>'amount_paid')::numeric, 0),<br>        COALESCE((p_record->>'credit_balance')::numeric, 0),<br>        COALESCE(NULLIF(p_record->>'payment_type', ''), 'Cash'),<br>        COALESCE(NULLIF(p_record->>'date_sold', '')::date, CURRENT_DATE),<br>        COALESCE(p_record->>'customer_name', ''),<br>        COALESCE(p_record->>'customer_phone', ''),<br>        COALESCE(p_record->>'mobile_money_type', ''),<br>        COALESCE(p_record->'hybrid_breakdown', '{}'::jsonb),<br>        COALESCE((p_record->>'advance_payment')::numeric, 0),<br>        NULLIF(p_record->>'advance_payment_date', '')::date,<br>        NULLIF(p_record->>'credit_status', ''),<br>        p_record->>'receipt_id',<br>        NULLIF(p_record->>'product_id', '')::uuid,<br>        COALESCE(p_record->>'username', ''),<br>        p_user_id,      -- 🔥 Cannot be spoofed via JSON<br>        p_business_id,  -- 🔥 Cannot be spoofed via JSON<br>        COALESCE(NULLIF(p_record->>'created_at', '')::timestamptz, NOW())<br>    )<br>    RETURNING row_to_json(public.sales.*) INTO v_result;<br><br>    RETURN v_result;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
| insert_sales_bulk_secure              | CREATE OR REPLACE FUNCTION public.insert_sales_bulk_secure(p_records jsonb, p_user_id uuid, p_business_id uuid)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE v_result jsonb;<br>BEGIN<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br>    PERFORM set_config('app.current_user_id', p_user_id::text, false);<br>    <br>    -- Force user_id and business_id on EVERY row in the bulk insert<br>    WITH forced_data AS (<br>        SELECT <br>            r->>'product_name' AS product_name,<br>            COALESCE(r->>'type', 'product') AS type,<br>            COALESCE((r->>'quantity')::numeric, 1) AS quantity,<br>            COALESCE((r->>'price')::numeric, 0) AS price,<br>            COALESCE((r->>'total_amount')::numeric, 0) AS total_amount,<br>            COALESCE(r->>'payment_type', 'Cash') AS payment_type,<br>            COALESCE((r->>'date_sold')::date, CURRENT_DATE) AS date_sold,<br>            r->>'customer_name' AS customer_name,<br>            r->>'receipt_id' AS receipt_id,<br>            p_user_id AS user_id,<br>            p_business_id AS business_id<br>        FROM jsonb_array_elements(p_records) r<br>    )<br>    INSERT INTO public.sales (<br>        product_name, type, quantity, price, total_amount, payment_type,<br>        date_sold, customer_name, receipt_id, user_id, business_id, created_at<br>    )<br>    SELECT *, NOW() FROM forced_data<br>    RETURNING jsonb_agg(row_to_json(public.sales.*)) INTO v_result;<br>    <br>    RETURN COALESCE(v_result, '[]'::jsonb);<br>END; $function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
| insert_stock_history_secure           | CREATE OR REPLACE FUNCTION public.insert_stock_history_secure(p_record jsonb, p_user_id uuid, p_business_id uuid)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE<br>    v_result         jsonb;<br>    v_qty_raw        text;<br>    v_quantity_change numeric := 0;<br>BEGIN<br>    -- ── Guards ───────────────────────────────────────────────────<br>    IF p_business_id IS NULL THEN<br>        RAISE EXCEPTION 'BUSINESS_ID_REQUIRED';<br>    END IF;<br><br>    -- Session context (RLS / triggers)<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br>    PERFORM set_config('app.current_user_id',     p_user_id::text,     false);<br><br>    -- ── Safe numeric parse ───────────────────────────────────────<br>    -- Accepts: "+3", "-2", "3.5", "3"<br>    -- Defaults to 0 for: NULL, "", "N/A", "abc", anything non-numeric<br>    v_qty_raw := NULLIF(TRIM(COALESCE(p_record->>'quantity_change', '')), '');<br><br>    IF v_qty_raw IS NOT NULL AND v_qty_raw ~ '^[+-]?[0-9]+(\\.[0-9]+)?$' THEN<br>        v_quantity_change := v_qty_raw::numeric;<br>    ELSE<br>        v_quantity_change := 0;<br>    END IF;<br><br>    -- ── Atomic insert ────────────────────────────────────────────<br>    WITH inserted AS (<br>        INSERT INTO public.stock_history (<br>            item_name,<br>            action,<br>            quantity_change,<br>            username,<br>            user_id,<br>            business_id,<br>            timestamp<br>        )<br>        VALUES (<br>            COALESCE(p_record->>'item_name', 'Unknown'),<br>            COALESCE(p_record->>'action',    'No action'),<br>            v_quantity_change,<br>            COALESCE(p_record->>'username',  'Unknown'),<br>            p_user_id,<br>            p_business_id,<br>            COALESCE(NULLIF(p_record->>'timestamp','')::timestamptz, NOW())<br>        )<br>        RETURNING *<br>    )<br>    SELECT to_jsonb(inserted) INTO v_result FROM inserted;<br><br>    RETURN v_result;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
| insert_stock_secure                   | CREATE OR REPLACE FUNCTION public.insert_stock_secure(p_record jsonb, p_user_id uuid, p_business_id uuid)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE<br>    v_result        jsonb;<br>    v_barcode       text;<br>    v_existing_name text;<br>BEGIN<br>    -- Session context<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br>    PERFORM set_config('app.current_user_id',     p_user_id::text,     false);<br><br>    -- Guard: never proceed without a business<br>    IF p_business_id IS NULL THEN<br>        RAISE EXCEPTION 'BUSINESS_ID_REQUIRED';<br>    END IF;<br><br>    -- Normalise barcode: '' or whitespace → NULL<br>    v_barcode := NULLIF(TRIM(COALESCE(p_record->>'barcode', '')), '');<br><br>    ------------------------------------------------------------------<br>    -- BARCODE DUPLICATE CHECK — SCOPED TO p_business_id ONLY.<br>    -- Different businesses may share the same barcode.<br>    ------------------------------------------------------------------<br>    IF v_barcode IS NOT NULL THEN<br>        SELECT s.name<br>          INTO v_existing_name<br>          FROM public.stock AS s<br>         WHERE s.business_id = p_business_id           -- 🔒 SAME BUSINESS ONLY<br>           AND s.barcode IS NOT NULL<br>           AND TRIM(s.barcode) <> ''<br>           AND (<br>                TRIM(s.barcode) = v_barcode<br>                OR (<br>                    TRIM(LEADING '0' FROM s.barcode) = TRIM(LEADING '0' FROM v_barcode)<br>                    AND TRIM(LEADING '0' FROM v_barcode) <> ''<br>                )<br>           )<br>         LIMIT 1;<br><br>        IF v_existing_name IS NOT NULL THEN<br>            RAISE EXCEPTION 'BARCODE_EXISTS_DB:%', v_existing_name;<br>        END IF;<br>    END IF;<br><br>    -- Atomic insert<br>    WITH inserted AS (<br>        INSERT INTO public.stock (<br>            id, name, type, quantity, price, cost_price,<br>            barcode, image, category, subcategory, tax_rate,<br>            hasbeensold, username, date_added,<br>            user_id, business_id, created_at, updated_at<br>        )<br>        VALUES (<br>            COALESCE(NULLIF(p_record->>'id', '')::uuid, gen_random_uuid()),<br>            p_record->>'name',<br>            COALESCE(NULLIF(p_record->>'type', ''), 'product'),<br>            COALESCE(NULLIF(p_record->>'quantity',   '')::numeric, 0),<br>            NULLIF(p_record->>'price',      '')::numeric,<br>            NULLIF(p_record->>'cost_price', '')::numeric,<br>            v_barcode,<br>            NULLIF(p_record->>'image',   ''),<br>            NULLIF(p_record->>'category',    ''),<br>            NULLIF(p_record->>'subcategory', ''),<br>            COALESCE(NULLIF(p_record->>'tax_rate', '')::numeric, 0),<br>            COALESCE(NULLIF(p_record->>'hasbeensold', '')::boolean, false),<br>            NULLIF(p_record->>'username', ''),<br>            COALESCE(NULLIF(p_record->>'date_added', '')::timestamptz, NOW()),<br>            p_user_id,<br>            p_business_id,<br>            COALESCE(NULLIF(p_record->>'created_at', '')::timestamptz, NOW()),<br>            COALESCE(NULLIF(p_record->>'updated_at', '')::timestamptz, NOW())<br>        )<br>        RETURNING *<br>    )<br>    SELECT to_jsonb(inserted) INTO v_result FROM inserted;<br><br>    RETURN v_result;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
| insert_task_secure                    | CREATE OR REPLACE FUNCTION public.insert_task_secure(p_record jsonb, p_user_id uuid, p_business_id uuid)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE v_result jsonb;<br>BEGIN<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br>    PERFORM set_config('app.current_user_id', p_user_id::text, false);<br>    <br>    INSERT INTO public.tasks (title, description, assigned_to, created_by, due_date, status, is_announcement, is_active, user_id, business_id, created_at)<br>    VALUES (<br>        p_record->>'title', p_record->>'description', COALESCE(p_record->>'assigned_to', 'all'),<br>        COALESCE(p_record->>'created_by', 'Unknown'), (p_record->>'due_date')::date,<br>        COALESCE(p_record->>'status', 'pending'), COALESCE((p_record->>'is_announcement')::boolean, false),<br>        COALESCE((p_record->>'is_active')::boolean, true), p_user_id, p_business_id, NOW()<br>    ) RETURNING row_to_json(public.tasks.*) INTO v_result;<br>    RETURN v_result;<br>END; $function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
| logout_all_sessions_secure            | CREATE OR REPLACE FUNCTION public.logout_all_sessions_secure(p_token text, p_business_id uuid)<br> RETURNS void<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>BEGIN<br>    PERFORM public.assert_session(p_token, p_business_id);<br>    DELETE FROM public.sessions WHERE business_id = p_business_id;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
| mark_notification_read_secure         | CREATE OR REPLACE FUNCTION public.mark_notification_read_secure(p_notification_id uuid, p_business_id uuid)<br> RETURNS void<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>BEGIN<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br>    <br>    UPDATE public.notifications<br>    SET is_read = true, updated_at = NOW()<br>    WHERE id = p_notification_id;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
| process_supermarket_checkout          | CREATE OR REPLACE FUNCTION public.process_supermarket_checkout(p_sales jsonb, p_stock_updates jsonb, p_history_inserts jsonb, p_business_id uuid)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>BEGIN<br>    -- 1. Set context ONCE for the entire transaction (Bypasses PgBouncer drop)<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br><br>    -- 2. Batch insert ALL sales in one go<br>    INSERT INTO public.sales<br>    SELECT * FROM jsonb_populate_recordset(null::public.sales, p_sales);<br><br>    -- 3. Batch update ALL stock in one go (using a highly efficient JOIN)<br>    IF p_stock_updates IS NOT NULL AND jsonb_array_length(p_stock_updates) > 0 THEN<br>        UPDATE public.stock AS s<br>        SET <br>            quantity = u.quantity,<br>            hasbeensold = u.hasbeensold,<br>            updated_at = u.updated_at<br>        FROM jsonb_to_recordset(p_stock_updates) AS u(<br>            id uuid,<br>            quantity numeric,<br>            hasbeensold boolean,<br>            updated_at timestamp<br>        )<br>        WHERE s.id = u.id;<br>    END IF;<br><br>    -- 4. Batch insert ALL history logs in one go<br>    IF p_history_inserts IS NOT NULL AND jsonb_array_length(p_history_inserts) > 0 THEN<br>        INSERT INTO public.stock_history<br>        SELECT * FROM jsonb_populate_recordset(null::public.stock_history, p_history_inserts);<br>    END IF;<br><br>    -- Return success<br>    RETURN jsonb_build_object('success', true, 'message', 'Checkout processed successfully');<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
| rls_auto_enable                       | CREATE OR REPLACE FUNCTION public.rls_auto_enable()<br> RETURNS event_trigger<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'pg_catalog'<br>AS $function$<br>DECLARE<br>  cmd record;<br>BEGIN<br>  FOR cmd IN<br>    SELECT *<br>    FROM pg_event_trigger_ddl_commands()<br>    WHERE command_tag IN ('CREATE TABLE', 'CREATE TABLE AS', 'SELECT INTO')<br>      AND object_type IN ('table','partitioned table')<br>  LOOP<br>     IF cmd.schema_name IS NOT NULL AND cmd.schema_name IN ('public') AND cmd.schema_name NOT IN ('pg_catalog','information_schema') AND cmd.schema_name NOT LIKE 'pg_toast%' AND cmd.schema_name NOT LIKE 'pg_temp%' THEN<br>      BEGIN<br>        EXECUTE format('alter table if exists %s enable row level security', cmd.object_identity);<br>        RAISE LOG 'rls_auto_enable: enabled RLS on %', cmd.object_identity;<br>      EXCEPTION<br>        WHEN OTHERS THEN<br>          RAISE LOG 'rls_auto_enable: failed to enable RLS on %', cmd.object_identity;<br>      END;<br>     ELSE<br>        RAISE LOG 'rls_auto_enable: skip % (either system schema or not in enforced list: %.)', cmd.object_identity, cmd.schema_name;<br>     END IF;<br>  END LOOP;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
| search_customer_suggestions_secure    | CREATE OR REPLACE FUNCTION public.search_customer_suggestions_secure(p_search_term text, p_business_id uuid)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE<br>    v_suggestions jsonb;<br>BEGIN<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br>    <br>    -- UNION ALL + GROUP BY elegantly merges names and fills in missing phone numbers<br>    SELECT jsonb_agg(row_to_json(subq)) INTO v_suggestions<br>    FROM (<br>        SELECT name, MAX(phone) AS phone<br>        FROM (<br>            SELECT customer_name AS name, customer_phone AS phone FROM public.sales WHERE business_id = p_business_id AND customer_name ILIKE p_search_term<br>            UNION ALL<br>            SELECT customer_name AS name, customer_phone AS phone FROM public.credit_sales WHERE business_id = p_business_id AND customer_name ILIKE p_search_term<br>            UNION ALL<br>            SELECT name, phone FROM public.customers WHERE business_id = p_business_id AND name ILIKE p_search_term<br>        ) AS combined<br>        WHERE name IS NOT NULL AND TRIM(name) != '' AND TRIM(name) != 'Tapez le nom du client'<br>        GROUP BY name<br>        ORDER BY name ASC<br>        LIMIT 10<br>    ) AS subq;<br>    <br>    RETURN COALESCE(v_suggestions, '[]'::jsonb);<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
| search_customers_secure               | CREATE OR REPLACE FUNCTION public.search_customers_secure(p_search_term text, p_business_id uuid)<br> RETURNS SETOF customers<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>BEGIN<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br>    <br>    RETURN QUERY <br>    SELECT * FROM public.customers <br>    WHERE business_id = p_business_id <br>      AND (name ILIKE p_search_term OR phone ILIKE p_search_term)<br>    LIMIT 50;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
| set_business_created_by               | CREATE OR REPLACE FUNCTION public.set_business_created_by()<br> RETURNS trigger<br> LANGUAGE plpgsql<br> SET search_path TO 'public'<br>AS $function$<br>BEGIN<br>    IF NEW.created_by IS NULL THEN<br>        NEW.created_by = current_setting('app.current_user_id', TRUE)::UUID;<br>    END IF;<br>    RETURN NEW;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      