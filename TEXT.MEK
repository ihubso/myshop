                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
| insert_expense_secure                 | CREATE OR REPLACE FUNCTION public.insert_expense_secure(p_record jsonb, p_user_id uuid, p_business_id uuid)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE v_result jsonb;<br>BEGIN<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br>    PERFORM set_config('app.current_user_id', p_user_id::text, false);<br>    <br>    INSERT INTO public.expenses (description, amount, date, category, notes, type, loan_id, user_id, business_id, username, created_at)<br>    VALUES (<br>        p_record->>'description', COALESCE((p_record->>'amount')::numeric, 0),<br>        COALESCE((p_record->>'date')::date, CURRENT_DATE), COALESCE(p_record->>'category', 'general'),<br>        p_record->>'notes', p_record->>'type', (p_record->>'loan_id')::uuid,<br>        p_user_id, p_business_id, COALESCE(p_record->>'username', 'Unknown'), NOW()<br>    ) RETURNING row_to_json(public.expenses.*) INTO v_result;<br>    RETURN v_result;<br>END; $function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
| insert_loan_secure                    | CREATE OR REPLACE FUNCTION public.insert_loan_secure(p_record jsonb, p_user_id uuid, p_business_id uuid)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE v_result jsonb;<br>BEGIN<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br>    PERFORM set_config('app.current_user_id', p_user_id::text, false);<br>    <br>    INSERT INTO public.loans (borrower, borrower_contact, loan_type, amount, interest_rate, issue_date, due_date, purpose, status, repayments, user_id, business_id, created_by, created_at)<br>    VALUES (<br>        p_record->>'borrower', p_record->>'borrower_contact', COALESCE(p_record->>'loan_type', 'personal'),<br>        COALESCE((p_record->>'amount')::numeric, 0), COALESCE((p_record->>'interest_rate')::numeric, 0),<br>        COALESCE((p_record->>'issue_date')::date, CURRENT_DATE), (p_record->>'due_date')::date,<br>        p_record->>'purpose', COALESCE(p_record->>'status', 'Active'), COALESCE((p_record->>'repayments')::jsonb, '[]'::jsonb),<br>        p_user_id, p_business_id, COALESCE(p_record->>'created_by', 'Unknown'), NOW()<br>    ) RETURNING row_to_json(public.loans.*) INTO v_result;<br>    RETURN v_result;<br>END; $function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  