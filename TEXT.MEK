                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
| insert_business_info_secure           | CREATE OR REPLACE FUNCTION public.insert_business_info_secure(p_record jsonb, p_business_id uuid)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>DECLARE<br>    v_result jsonb;<br>BEGIN<br>    PERFORM set_config('app.current_business_id', p_business_id::text, false);<br>    <br>    INSERT INTO public.business_info<br>    SELECT * FROM jsonb_populate_record(null::public.business_info, p_record)<br>    RETURNING row_to_json(business_info.*) INTO v_result;<br>    <br>    RETURN v_result;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   