// Expose them globally

    function initializeAppHistoryState() {
        // Reset any stale history state on page load so old popstate data doesn't persist.
        window.history.replaceState({ view: 'dashboard' }, '', window.location.href);
        window.currentModalId = null;
        window.currentStockSubsection = null;
        window.currentSalesSubsection = null;
    }

    window.navigateToView = navigateToView;
    window.initializeAppHistoryState = initializeAppHistoryState;
    window.closeStockOptionsModalWithHistory = closeStockOptionsModalWithHistory;
window.closeSalesOptionsModalWithHistory = closeSalesOptionsModalWithHistory;

    /**
     * Setup global back button handler for all modals
     */
    window.addEventListener('popstate', function(event) {
    console.log('POPSTATE FIRED');
    console.log(event.state);
});
function setupGlobalBackButtonHandler() {
    if (window._backButtonHandlerSetup) return;
    window._backButtonHandlerSetup = true;
    
    window.addEventListener('popstate', function(event) {

        // Close modal if one is open
        if (window.currentModalId) {
            const modal = document.getElementById(window.currentModalId);
            if (modal && !modal.classList.contains('hidden')) {
                closeModal(window.currentModalId);
                event.preventDefault();
                return;
            }
        }
            if (currentModalId) {
        hideModal(currentModalId, true);
    }
  if (event.state && event.state.modal === 'notes') {
        // User pressed back from notes - close the modal
        closeNotesModal();
    } else if (!event.state && notesModal && !notesModal.classList.contains('hidden')) {
        // Back to original state - close modal
        closeNotesModal();
    }

        const supermarketModeModal = document.getElementById('supermarketModeModal');
        if (supermarketModeModal && !supermarketModeModal.classList.contains('hidden')) {
            supermarketModeModal.classList.add('hidden');
            closeSupermarketMode() 
            const salesOptionsModal = document.getElementById('salesOptionsModal');
              salesOptionsModal.classList.remove('hidden');
            event.preventDefault();
            return;
        }

                const recordNewSaleSection = document.getElementById('recordNewSaleSection');
        if (recordNewSaleSection && !recordNewSaleSection.classList.contains('hidden')) {
            recordNewSaleSection.classList.add('hidden');
             const salesOptionsModal = document.getElementById('salesOptionsModal');
              salesOptionsModal.classList.remove('hidden');
            showSalesManagement();
            event.preventDefault();
            return;
        }
        const salesHistorySection = document.getElementById('sales-history-section');
        if (salesHistorySection && !salesHistorySection.classList.contains('hidden')) {
            salesHistorySection.classList.add('hidden');
            const salesOptionsModal = document.getElementById('salesOptionsModal');
              salesOptionsModal.classList.remove('hidden');
                showSalesManagement();
            event.preventDefault();
            return;
        }

        // Close print preview modal
        const printPreviewModal = document.getElementById('printPreviewModal');
        if (printPreviewModal && !printPreviewModal.classList.contains('hidden')) {
            printPreviewModal.classList.add('hidden');
            closePrintPreviewModal();
            event.preventDefault();
            return;
        }
        
        // Close expenses section
        const expensesSection = document.getElementById('expensesSection');
        if (expensesSection && !expensesSection.classList.contains('hidden')) {
            expensesSection.classList.add('hidden');
            const salesHistorySection = document.getElementById('sales-history-section');
            if (salesHistorySection) {
                salesHistorySection.classList.remove('hidden');
                salesHistorySection.classList.add('MODAL-LOCK-OPEN');
            }
            const expenseModal = document.getElementById('expenseModal');
            if (expenseModal) {
                expenseModal.classList.add('hidden');
            }
            console.log('Expenses section hidden, sales history shown');
            event.preventDefault();
            return;
        }
                        const salesOptionsModal = document.getElementById('salesOptionsModal');
        if (salesOptionsModal && !salesOptionsModal.classList.contains('hidden')) {
            salesOptionsModal.classList.add('hidden');
            closeSalesOptionsModal();
            event.preventDefault();
            return;
        }
        // Close credit sales section
        const creditSalesSection = document.getElementById('creditSalesSection');
        if (creditSalesSection && !creditSalesSection.classList.contains('hidden')) {
            creditSalesSection.classList.add('hidden');
            const salesHistorySection = document.getElementById('sales-history-section');
            if (salesHistorySection) {
                salesHistorySection.classList.remove('hidden');
                salesHistorySection.classList.add('MODAL-LOCK-OPEN');
            }
            event.preventDefault();
            return;
        }
        
        // Close receipt modal
        const receiptModal = document.getElementById('receiptModal');
        if (receiptModal && !receiptModal.classList.contains('hidden')) {
            receiptModal.classList.add('hidden');
            closeReceiptModal();
            event.preventDefault();
            return;
        }
        
        // Clean up custom receipt modal
        const customReceiptModal = document.getElementById('customReceiptModal');
        if (customReceiptModal && !customReceiptModal.classList.contains('hidden')) {
            // Clone and replace buttons to remove event listeners
            document.querySelectorAll('.add-to-custom-receipt, .remove-custom-item').forEach(btn => {
                btn.replaceWith(btn.cloneNode(true));
            });
            
            // Clone and replace quantity inputs
            document.querySelectorAll('.custom-receipt-qty').forEach(input => {
                input.replaceWith(input.cloneNode(true));
            });
            
            // Clear form fields
            ['customReceiptCustomerFilter', 'customReceiptDateFilter'].forEach(id => {
                const el = document.getElementById(id);
                if (el) el.value = '';
            });
            
            // Clear tables
            ['customReceiptProductTable', 'customReceiptSelectedTable'].forEach(id => {
                const el = document.getElementById(id);
                if (el) el.innerHTML = '';
            });
            
            // Reset totals and headers
            const total = document.getElementById('customReceiptTotal');
            if (total) total.textContent = '0.00';
            
            const headerDate = document.getElementById('customReceiptHeaderDate');
            if (headerDate) headerDate.textContent = '';
            
            // Clear suggestions
            const suggestions = document.getElementById('customCustomerSuggestions');
            if (suggestions) {
                suggestions.innerHTML = '';
                suggestions.classList.add('hidden');
            }
            
            // Reset data - declare if not already global
            if (typeof window.currentCustomReceiptData !== 'undefined') {
                window.currentCustomReceiptData = null;
            }
            if (typeof window.customReceiptItems !== 'undefined') {
                window.customReceiptItems = [];
            }
            
            // Hide modal
            customReceiptModal.classList.add('hidden');
            
            console.log('Custom receipt modal cleaned and hidden');
            event.preventDefault();
            return;
        }
        
        // Close customer transactions modal
        const customerTransactionsModal = document.getElementById('customerTransactionsModal');
        if (customerTransactionsModal && !customerTransactionsModal.classList.contains('hidden')) {
            customerTransactionsModal.classList.add('hidden');
            window.customerTransactionsData = null;
            window.currentCustomerName = null;
            if (typeof closeCustomerTransactionsModal === 'function') {
                closeCustomerTransactionsModal();
            }
            event.preventDefault();
            return;
        }
        

        // Close mobile drawer
        const mobileDrawer = document.getElementById('mobile-drawer');
        if (mobileDrawer && !mobileDrawer.classList.contains('hidden')) {
            if (typeof window.closeMobileDrawer === 'function') {
                window.closeMobileDrawer();
            } else {
                mobileDrawer.classList.add('hidden');
                document.body.style.overflow = '';
            }
            event.preventDefault();
            return;
        }
        
        // Close quantity modal
        const quantityActionModal = document.getElementById('quantityActionModal');
        if (quantityActionModal && !quantityActionModal.classList.contains('hidden')) {
            quantityActionModal.classList.add('hidden');
            if (typeof closeQuantityActionModal === 'function') {
                closeQuantityActionModal();
            }
            event.preventDefault();
            return;
        }
        
        // Close QR generation modal
        const qrGenerationModal = document.getElementById('qrGenerationModal');
        if (qrGenerationModal && !qrGenerationModal.classList.contains('hidden')) {
            qrGenerationModal.classList.add('hidden');
            if (typeof closeQrGenerationModal === 'function') {
                closeQrGenerationModal();
            }
            event.preventDefault();
            return;
        }
        
        // Close item details modal
        const itemDetailsModal = document.getElementById('itemDetailsModal');
        if (itemDetailsModal && !itemDetailsModal.classList.contains('hidden')) {
            itemDetailsModal.classList.add('hidden');
            if (typeof closeItemDetailsModal === 'function') {
                closeItemDetailsModal();
            }
            event.preventDefault();
            return;
        }

        // Handle open modals
        if (window.currentModalId) {
            const modal = document.getElementById(window.currentModalId);
            if (modal && !modal.classList.contains('hidden')) {
                // Stock subsection
                if (window.currentModalId === 'stockOptionsModal' && window.currentStockSubsection) {
                    if (typeof showStockManagement === 'function') showStockManagement();
                    event.preventDefault();
                    return;
                }
                
                // Sales subsection
                if (window.currentModalId === 'salesOptionsModal' && window.currentSalesSubsection) {
                    if (typeof closeCurrentSalesSubsection === 'function') closeCurrentSalesSubsection();
                    event.preventDefault();
                    return;
                }
                
                // Stock options modal
                if (window.currentModalId === 'stockOptionsModal') {
                    if (typeof closeStockOptionsModalWithHistory === 'function') {
                        closeStockOptionsModalWithHistory(true);
                    } else {
                        const stockOptionsModal = document.getElementById('stockOptionsModal');
                        if (stockOptionsModal) {
                            stockOptionsModal.classList.add('hidden');
                            document.body.style.overflow = '';
                            window.currentModalId = null;
                            window.currentStockSubsection = null;
                        }
                    }
                    event.preventDefault();
                    return;
                }
                
                // Sales options modal
                if (window.currentModalId === 'salesOptionsModal') {
                    if (typeof closeSalesOptionsModalWithHistory === 'function') {
                        closeSalesOptionsModalWithHistory(true);
                    } else {
                        const salesOptionsModal = document.getElementById('salesOptionsModal');
                        if (salesOptionsModal) {
                            salesOptionsModal.classList.add('hidden');
                            document.body.style.overflow = '';
                            window.currentModalId = null;
                            window.currentSalesSubsection = null;
                        }
                    }
                    event.preventDefault();
                    return;
                }
                
                // Logout modal
                if (window.currentModalId === 'logoutModal') {
                    if (window._logoutTimer) {
                        clearInterval(window._logoutTimer);
                        window._logoutTimer = null;
                    }
                    if (typeof hideModalWithHistory === 'function') hideModalWithHistory(window.currentModalId, true);
                    event.preventDefault();
                    return;
                }
                
                // Image zoom modal
                if (window.currentModalId === 'imageZoomModal' && typeof closeImageZoom === 'function') {
                    closeImageZoom(true);
                    event.preventDefault();
                    return;
                }
                
                // Business settings modal
                if (window.currentModalId === 'businessSettingsModal' && typeof closeBusinessSettingsModal === 'function') {
                    closeBusinessSettingsModal(true);
                    event.preventDefault();
                    return;
                }
                
                // Admin profile modal
                if (window.currentModalId === 'adminProfileModal' && typeof closeAdminProfileModal === 'function') {
                    closeAdminProfileModal(true);
                    event.preventDefault();
                    return;
                }
                
                // Default modal close
                if (typeof hideModalWithHistory === 'function') {
                    hideModalWithHistory(window.currentModalId, true);
                } else {
                    const modalToClose = document.getElementById(window.currentModalId);
                    if (modalToClose) {
                        modalToClose.classList.add('hidden');
                        document.body.style.overflow = '';
                        window.currentModalId = null;
                    }
                }
                event.preventDefault();
                return;
            }
        }
        
        // Navigate between app views
        const view = event.state && event.state.view ? event.state.view : 'dashboard';
        if (view && typeof navigateToView === 'function') {
            navigateToView(view);
            event.preventDefault();
            return;
        }
    });
}
