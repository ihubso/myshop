// Sidebar Component - Injects a responsive left sidebar navigation
(function() {
    'use strict';

    // Global variable to track current open modal (for back button)
    window.currentModalId = window.currentModalId || null;
    window._logoutTimer = null;
    window.currentStockSubsection = null;  // Track which stock subsection is open
window.currentSalesSubsection = null;
window.closeCurrentStockSubsection = closeCurrentStockSubsection;
window.closeCurrentSalesSubsection = closeCurrentSalesSubsection;
  window.updateMobileLowStock = updateMobileLowStockDot;

// Safe fixImagePath function that doesn't break if the original isn't available
function safeFixImagePath(path) {
    if (!path) return '';
    if (path.startsWith('http')) return path;
    if (path.startsWith('data:')) return path;
    if (path.startsWith('/')) return path; // 👈 ADDED: Preserve absolute server paths

    // If it's a Supabase storage path (logos/, photos/, images/, public/)
    if (path.includes('logos/') || path.includes('photos/') || path.includes('images/') || path.includes('public/')) {
        return `${path}`;
    }
    
    return path;
}
    // ========== MODAL HISTORY HELPERS ==========

    /**
     * Hide modal with history cleanup
     */
    function hideModalWithHistory(modalId, isFromBackButton = false) {
        const modal = document.getElementById(modalId);
        if (!modal) return false;
        
        // Hide the modal
        modal.classList.add('hidden');
        
        // Handle scale classes if they exist
        const content = modal.querySelector('.scale-100');
        if (content) {
            content.classList.remove('scale-100');
            content.classList.add('scale-95');
        }
        
        // Restore body scroll
        document.body.style.overflow = '';
        
        // Update history if not from back button
        if (!isFromBackButton && window.currentModalId === modalId) {
            window.history.pushState({ modal: null }, '', window.location.href);
            window.currentModalId = null;
        } else if (isFromBackButton) {
            window.currentModalId = null;
        }
        
        return true;
    }

    /**
     * Close current modal (generic)
     */
    function closeCurrentModal() {
        if (window.currentModalId) {
            const modal = document.getElementById(window.currentModalId);
            if (modal && !modal.classList.contains('hidden')) {
                hideModalWithHistory(window.currentModalId);
            }
        }
    }

    /**
     * Navigate app views using history state
     */
function navigateToView(viewName) {
    const dashboardContainer = document.getElementById('main-dashboard-container');
    const dashcontainer = document.getElementById('dashcontainer');
    const stockManagementSection = document.getElementById('stockManagementSection');
    const salesManagementSection = document.getElementById('salesManagementSection');
    const stockOptionsModal = document.getElementById('stockOptionsModal');
    const salesOptionsModal = document.getElementById('salesOptionsModal');
    const addItemSection = document.getElementById('addItemSection');
    const currentStockSection = document.getElementById('currentStockSection');
    const stockHistorySection = document.getElementById('stock-history-section');
    const profitLossSection = document.getElementById('profitLossSection');
    const weeklySalesSection = document.getElementById('weeklySalesSection');
    const monthlySalesSection = document.getElementById('monthlySalesSection');
    const creditSalesSection = document.getElementById('creditSalesSection');
    const groupedBySubcategorySection = document.getElementById('groupedBySubcategorySection');
    const recordNewSaleSection = document.getElementById('recordNewSaleSection');
    const salesHistorySection = document.getElementById('sales-history-section');
    const expensesSection = document.getElementById('expensesSection');
    const refundHistoryModal = document.getElementById('refundHistoryModal');
        const supermarketModeModal = document.getElementById('supermarketModeModal');
   

    if (viewName === 'stock') {
        // Hide all subsections first
        if (addItemSection) addItemSection.classList.add('hidden');
        if (currentStockSection) currentStockSection.classList.add('hidden');
        if (stockHistorySection) stockHistorySection.classList.add('hidden');
        if (profitLossSection) profitLossSection.classList.add('hidden');
        if (weeklySalesSection) weeklySalesSection.classList.add('hidden');
        if (monthlySalesSection) monthlySalesSection.classList.add('hidden');
        if (creditSalesSection) creditSalesSection.classList.add('hidden');
        if (groupedBySubcategorySection) groupedBySubcategorySection.classList.add('hidden');
        if (recordNewSaleSection) recordNewSaleSection.classList.add('hidden');
        if (salesHistorySection) salesHistorySection.classList.add('hidden');
        if (expensesSection) expensesSection.classList.add('hidden');
        if (refundHistoryModal) refundHistoryModal.classList.add('hidden');
          supermarketModeModal.classList.add('hidden'); 
        if (stockOptionsModal) stockOptionsModal.classList.remove('hidden');
        if (salesOptionsModal) salesOptionsModal.classList.add('hidden');
        if (stockManagementSection) stockManagementSection.classList.remove('hidden');
        if (salesManagementSection) salesManagementSection.classList.add('hidden');
        if (dashboardContainer) { 
            dashboardContainer.classList.add('nosee'); 
            dashboardContainer.classList.remove('see'); 
        }
        if (dashcontainer) dashcontainer.classList.add('hidden');
        
        // Reset tracking
        window.currentStockSubsection = null;
        window.currentSalesSubsection = null;
        window.currentModalId = 'stockOptionsModal';
        
        if (typeof hideHomeOverlay === 'function') hideHomeOverlay();
        document.title = "StocksalesApp -> Let's take a look at the shop inventory items";
        
    } else if (viewName === 'sales') {
        // Hide all subsections first
        if (addItemSection) addItemSection.classList.add('hidden');
        if (currentStockSection) currentStockSection.classList.add('hidden');
        if (stockHistorySection) stockHistorySection.classList.add('hidden');
        if (profitLossSection) profitLossSection.classList.add('hidden');
        if (weeklySalesSection) weeklySalesSection.classList.add('hidden');
        if (monthlySalesSection) monthlySalesSection.classList.add('hidden');
        if (creditSalesSection) creditSalesSection.classList.add('hidden');
        if (groupedBySubcategorySection) groupedBySubcategorySection.classList.add('hidden');
        if (recordNewSaleSection) recordNewSaleSection.classList.add('hidden');
        if (salesHistorySection) salesHistorySection.classList.add('hidden');
        if (expensesSection) expensesSection.classList.add('hidden');
         supermarketModeModal.classList.add('hidden'); closeSupermarketMode();
        if (refundHistoryModal) refundHistoryModal.classList.add('hidden');
        if (stockOptionsModal) stockOptionsModal.classList.add('hidden');
        if (salesOptionsModal) salesOptionsModal.classList.remove('hidden');
        if (stockManagementSection) stockManagementSection.classList.add('hidden');
        if (salesManagementSection) salesManagementSection.classList.remove('hidden');
        closeRefundHistoryModal();
        if (dashboardContainer) { 
            dashboardContainer.classList.add('nosee'); 
            dashboardContainer.classList.remove('see'); 
        }
        if (dashcontainer) dashcontainer.classList.add('hidden');
        
        // Reset tracking
        window.currentStockSubsection = null;
        window.currentSalesSubsection = null;
        window.currentModalId = 'salesOptionsModal';
        
        if (typeof hideHomeOverlay === 'function') hideHomeOverlay();
        document.title = "StocksalesApp -> Sales Registry";
        
    } else {
        // Hide all sections
        if (addItemSection) addItemSection.classList.add('hidden');
        if (currentStockSection) currentStockSection.classList.add('hidden');
        if (stockHistorySection) stockHistorySection.classList.add('hidden');
        if (profitLossSection) profitLossSection.classList.add('hidden');
        if (weeklySalesSection) weeklySalesSection.classList.add('hidden');
        if (monthlySalesSection) monthlySalesSection.classList.add('hidden');
        if (creditSalesSection) creditSalesSection.classList.add('hidden');
        if (groupedBySubcategorySection) groupedBySubcategorySection.classList.add('hidden');
        if (recordNewSaleSection) recordNewSaleSection.classList.add('hidden');
        if (salesHistorySection) salesHistorySection.classList.add('hidden');
        if (expensesSection) expensesSection.classList.add('hidden');
        if (supermarketModeModal) supermarketModeModal.classList.add('hidden'); 
        // Hide modals
        if (stockOptionsModal) stockOptionsModal.classList.add('hidden');
        if (salesOptionsModal) salesOptionsModal.classList.add('hidden');
        if (stockManagementSection) stockManagementSection.classList.add('hidden');
        if (salesManagementSection) salesManagementSection.classList.add('hidden');
        // Reset tracking
        window.currentStockSubsection = null;
        window.currentSalesSubsection = null;
        window.currentModalId = null;
        
        if (typeof showHomeOverlay === 'function') showHomeOverlay();
        document.title = "StocksalesApp";
    }
}
