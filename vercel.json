{
  "version": 5,
  "rewrites": [
    {
      "source": "/r/:receiptId",
      "destination": "/api/receipt?receipt=:receiptId"
    }
  ],
  "headers": [
    {
      "source": "/js/bundle.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate, max-age=0"
        }
      ]
    }
  ]
}